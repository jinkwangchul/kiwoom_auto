+def test_v5_stop_loss_red_glyph_uses_display_copies_and_cause_cache(case, kind):
+    from dataclasses import replace
+    from PyQt5.QtGui import QPainter, QPixmap
+    rows = candles(8)
+    markers = [{"evaluation_index": 2, "side": "BUY", "tooltip": "buy proof"}]
+    if kind != "absent":
+        markers.append({"evaluation_index": 7, "side": "SELL", "quantity": 0,
+                        "tooltip": "condition proof", "provenance": "configured_expression",
+                        "virtual_residual": kind == "residual"})
+    if kind == "limit":
+        markers += [{"evaluation_index": 7, "side": side, "tooltip": side}
+                    for side in ("LIMIT_ORDER", "LIMIT_SELL")]
+    canvas = window_module.IndicatorFollowSignalValidationChartCanvas(rows, markers, timeframe_key="M1")
+    case.widgets.append(canvas)
+    canvas.resize(800, 400)
+    canvas.set_validation_range(2, 7)
+    ordinary = window_module.IndicatorFollowValidationCompletedCycle(
+        1, (2,), 2, 2, 1, 100_002, 7, 100_007, 0)
+    canvas.set_completed_cycle_average_lines((ordinary,))
+    original = deepcopy(canvas.marker_records())
+    assert canvas._liquidation_marker_records() == []  # A raw SELL is not execution evidence.
+    stopped = replace(ordinary, close_reason="STOP_LOSS")
+    canvas._static_chart_cache = object()
+    canvas._static_chart_cache_key = object()
+    canvas.set_completed_cycle_average_lines((stopped, replace(stopped, cycle_number=2)))
+    assert canvas._static_chart_cache is None and canvas._static_chart_cache_key is None
+    red_records = canvas._liquidation_marker_records()
+    assert len(red_records) == 1
+    assert red_records[0]["side"] == "SELL" and red_records[0]["virtual_liquidation"]
+    assert not red_records[0].get("virtual_residual")
+    if kind != "absent":
+        assert red_records[0]["tooltip"] == "condition proof"
+        assert red_records[0]["provenance"] == "configured_expression"
+    polygons, ellipses = [], []
+    class RecordingPainter(QPainter):
+        def drawPolygon(self, polygon):
+            polygons.append((self.brush().color().name(), [(p.x(), p.y()) for p in polygon]))
+            return super().drawPolygon(polygon)
+        def drawEllipse(self, *args):
+            ellipses.append(self.brush().color().name())
+            return super().drawEllipse(*args)
+    pixmap = QPixmap(canvas.size())
+    painter = RecordingPainter(pixmap)
+    try:
+        canvas._paint_static_chart(painter, canvas.price_scale())
+    finally:
+        painter.end()
+    red = [points for color, points in polygons if color == "#ef4444"]
+    assert len(red) == 1
+    tip, left, right = red[0]
+    assert left == (tip[0] - 5, tip[1] - 10) and right == (tip[0] + 5, tip[1] - 10)
+    assert tip[1] - 8 == canvas._marker_y(7, "SELL", canvas.price_scale())
+    if kind == "limit":
+        assert "#ffffff" in ellipses
+        assert any(color == "#ffffff" for color, _points in polygons)
+    assert canvas.marker_records() == original and markers[0]["tooltip"] == "buy proof"
+    canvas._static_chart_cache = object()
+    canvas._static_chart_cache_key = object()
+    canvas.set_completed_cycle_average_lines((ordinary,))
+    assert canvas._static_chart_cache is None and canvas._static_chart_cache_key is None
+    assert canvas._liquidation_marker_records() == []
+    canvas.set_completed_cycle_average_lines((stopped,))
+    canvas.set_time_view(0, 5)
+    assert canvas._liquidation_marker_records() == []
+    canvas.set_validation_range(None, None)
+    assert canvas._liquidation_marker_records() == []
+    assert canvas.marker_records() == original
+
