+    cycle = window.completed_cycles[0]
+    assert (cycle.buy_indexes, cycle.sell_index, cycle.close_reason) == ((2,), 5, "STOP_LOSS")
+    offset = window._offset_completed_cycle(cycle, 3)
+    assert (offset.buy_indexes, offset.sell_index, offset.close_reason) == ((5,), 8, "STOP_LOSS")
+    assert window.completed_cycle_table.item(0, 5).text() == window._cycle_time(rows[5]["time"])
+    settings = window._range_replay_settings_snapshot
+    frozen = window_module.ValidationReplaySnapshot(
+        stock=case.stock, timeframe_minutes=1, timeframe_key="M1", settings_hash=settings.rules_hash,
+        historical_request_id="offline-display", evaluated_start_index=2, evaluated_end_index=5,
+        dropped_raw_rows_count=0, candles=rows,
