+    frozen_before = (frozen.to_candles(), frozen.to_entries())
+    window._range_replay_stop_snapshot = frozen
+    from routines.지표추종매매.routine_validation_replay import ValidationHistoricalReplay
+    with patch.object(ValidationHistoricalReplay, "evaluate_with_context",
+                      return_value=SimpleNamespace(ok=True, snapshot=frozen)) as evaluate, \
