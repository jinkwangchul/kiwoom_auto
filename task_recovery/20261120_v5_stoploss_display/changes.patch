+def _stop_display_entries(rows, *signals):
+    return [window_module.ValidationReplayEntry(
+        evaluation_side=side, evaluation_index=index, evaluation_time=rows[index]["time"],
+        signal=side, reason="display fixture", signal_index=index,
+        signal_time=rows[index]["time"], delay_bar=0, matched_groups=[], details=[],
+        trace={"conditions": [], "groups": [], "aggregations": []},
+    ) for side, index in signals]
+
+
+def _stop_display_window(case, rows, signals, policy, *, bounds=None, forced=False):
+    window = window_for(case)
+    install(window, rows)
+    window._set_validation_range(*(bounds or (0, len(rows) - 1)))
+    snapshot = window_module.ValidationSettingsSnapshot({"validation_execution": policy})
+    window._range_replay_entries_available = True
+    window._range_replay_entries = _stop_display_entries(rows, *signals)
+    window._range_replay_settings_snapshot = snapshot
+    with QSignalBlocker(window.validation_range_liquidation_check):
+        window.validation_range_liquidation_check.setChecked(forced)
+    with patch.object(window_module.QTimer, "singleShot"):
+        window._populate_completed_cycles()
+    return window
+
