+                return outcome("BLOCK_PROCESS_DISPATCH", "CYCLE_STOP_BLOCK_UNSENT_ORDER", proposal=deepcopy(row))
+            return outcome("STOP_AND_REVIEW", "CYCLE_STOP_UNFENCED_ORDER")
+        if status not in _SUCCESS_TERMINAL | _FAILURE_TERMINAL | {"BLOCKED", "BLOCKED_POLICY", "DONE", "FAILED"}:
+            return outcome("STOP_AND_REVIEW", "CYCLE_STOP_ORDER_STATUS_UNKNOWN")
+    position, holding, reasons = _holding_matches(positions=main_facts.get("positions", []),
+        holdings=main_facts.get("holdings", []), account_no=account, code=code)
+    if reasons:
+        return outcome("WAIT", "HOLDING_RECONCILIATION_PENDING")
+    try:
+        received = datetime.fromisoformat(holding["received_at"])
+        evidence_times = [datetime.fromisoformat(record["latched_at"])]
+        for row in orders + main_facts.get("fills", []):
+            if row in orders or any(_text(row.get("execution_id")) == _text(o.get("execution_id")) for o in orders):
+                value = row.get("updated_at") or row.get("received_at") or row.get("recorded_at")
+                if value:
+                    at = datetime.fromisoformat(value)
+                    evidence_times.append(at.replace(tzinfo=received.tzinfo) if at.tzinfo is None else at)
+        if received.tzinfo is None:
+            received = received.replace(tzinfo=evidence_times[0].tzinfo)
+        if received < max(evidence_times):
+            return outcome("WAIT", "HOLDING_RECONCILIATION_PENDING")
+    except (KeyError, TypeError, ValueError):
+        return outcome("WAIT", "HOLDING_RECONCILIATION_PENDING")
+    quantity = _nonnegative_int(holding.get("holding_quantity"))
+    if quantity == 0:
+        return outcome("UPDATE_CYCLE_EXIT", "CYCLE_STOP_FULL_CLOSE_CONFIRMED", complete=True,
+                       completion_evidence={"position": deepcopy(position), "holding": deepcopy(holding)})
+    if final_orders:
+        return outcome("STOP_AND_REVIEW", "CYCLE_STOP_FINAL_SELL_RESIDUAL_REVIEW")
+    pending = [row for row in main_facts.get("signals", []) if _as_dict(row.get("execution_intent")).get("cycle_stop_exit")
+               and _as_dict(row.get("execution_intent")).get("cycle_identity") == record["cycle_identity"]]
+    if pending:
+        if any(row.get("status") in {"PENDING", "PREVIEWED"} for row in pending):
+            return outcome("", "CYCLE_STOP_SELL_AWAITING_NORMAL_APPROVAL")
+        return outcome("STOP_AND_REVIEW", "CYCLE_STOP_FINAL_SIGNAL_REVIEW")
+    if _nonnegative_int(holding.get("available_quantity")) != quantity:
+        return outcome("WAIT", "HOLDING_RECONCILIATION_PENDING")
+    intent = dict(side="SELL", budget=None, code=code, account_no=account,
+        routine_type="INDICATOR_FOLLOW", routine_instance_id=record["routine_instance_id"],
+        cycle_identity=record["cycle_identity"], cycle_stop_exit=True, quantity=quantity,
+        planned_total_quantity=quantity, price=None, hoga="MARKET", price_basis="MARKET",
+        execution_mode="SINGLE_ORDER", execution_process_owner_required=False,
+        option_snapshot_hash=stable_hash({"cycle_stop": record["cycle_identity"], "rules": record.get("rules_identity")}),
+        plan_generation=0, child_sequence_index=1, child_sequence_total=1, child_kind="SINGLE_ORDER",
+        signal_price=_as_dict(record.get("stop_evidence")).get("current_price"),
+        child_plan={"planned_quantity": quantity, "planned_price": None})
+    signal = dict(signal="SELL", routine_type="INDICATOR_FOLLOW", routine_instance_id=record["routine_instance_id"],
+        cycle_identity=record["cycle_identity"], code=code, name=record.get("name", ""), reason="CYCLE_STOP_LOSS",
+        execution_intent=intent, execution_intents=[intent])
+    return outcome("REQUEST_FINAL_LIQUIDATION", "CYCLE_STOP_RESIDUAL_MARKET_SELL",
+                   proposal={"code": code, "new_signal": signal, "tick_key": record["latched_at"]})
