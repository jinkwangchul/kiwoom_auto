+def stop_price_evidence_valid(evidence: Any, *, now_kst: datetime, now_monotonic: float) -> bool:
+    """Validate original native clocks; never use the minute candle parser here."""
+    from candle_timeframe_aggregation import SEOUL_TIMEZONE
+
+    proof = _as_dict(evidence)
+    try:
+        market = datetime.fromisoformat(proof["market_datetime"])
+        received = datetime.fromisoformat(proof["received_at"])
+        receipt_mono = proof["received_monotonic"]
+        if (market.tzinfo is None or received.tzinfo is None or now_kst.tzinfo is None
+                or type(receipt_mono) not in (int, float) or not isfinite(receipt_mono)
+                or not isfinite(now_monotonic) or receipt_mono <= 0):
+            return False
+        market = market.astimezone(SEOUL_TIMEZONE)
+        received = received.astimezone(SEOUL_TIMEZONE)
+        current = now_kst.astimezone(SEOUL_TIMEZONE)
+        return (
+            proof.get("clock_instance_id") == CYCLE_EXIT_CLOCK_INSTANCE_ID
+            and proof.get("data_quality") == "NORMAL"
+            and type(proof.get("receive_sequence")) is int and proof["receive_sequence"] > 0
+            and type(proof.get("connection_epoch")) is int and proof["connection_epoch"] > 0
+            and bool(_clean_text(proof.get("login_session_id")))
+            and type(proof.get("current_price")) in (int, float)
+            and isfinite(proof["current_price"]) and proof["current_price"] > 0
+            and market.strftime("%H%M%S") == proof.get("execution_time_raw")
+            and market.date() == received.date() == current.date()
+            and received <= current
+            and 0 <= (current - market).total_seconds() <= 2
+            and 0 <= now_monotonic - receipt_mono <= 2
+        )
+    except (KeyError, TypeError, ValueError, OverflowError):
+        return False
 
 
