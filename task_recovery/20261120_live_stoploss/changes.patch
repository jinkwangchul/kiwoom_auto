+def cycle_exit_key(record: dict) -> str:
+    return hashlib.sha256(json.dumps([record.get(k) for k in (
+        "account_no", "code", "routine_instance_id", "cycle_identity")], ensure_ascii=False).encode()).hexdigest()
+
+
+def cycle_exit_records(root: dict) -> dict[str, dict]:
+    container = root.get("cycle_exits")
+    if container is None:
+        return {}
+    if (not isinstance(container, dict) or container.get("version") != 1
+            or not isinstance(container.get("records"), dict)
+            or any(not isinstance(v, dict) or v.get("state") not in {
+                "EXITING", "COMPLETE_WAIT_FALSE", "COMPLETE_WAIT_TRUE", "BASE_ELIGIBLE",
+                "BASE_ADMITTED", "REVIEW_REQUIRED"} for v in container["records"].values())):
+        raise ValueError("CYCLE_EXIT_RECORD_INVALID")
+    return container["records"]
+
+
+def _cycle_exit_subject(subject: dict) -> dict:
+    request = _as_dict(subject.get("execution_request"))
+    preview = _as_dict(request.get("request_preview"))
+    intent = _as_dict(subject.get("execution_intent") or request.get("execution_intent"))
+    return {**preview, **intent, **subject, "execution_intent": intent}
+
+
+def cycle_exit_buy_block_reason(root: dict, subject: dict) -> str:
+    item = _cycle_exit_subject(subject)
+    if _clean_text(item.get("side") or item.get("signal")).upper() != "BUY":
+        return ""
+    if _clean_text(item.get("order_action") or "NEW").upper() == "CANCEL":
+        return ""
+    intent = item["execution_intent"]
+    try:
+        records = cycle_exit_records(root)
+    except ValueError as exc:
+        return str(exc)
+    code = _clean_text(item.get("code")).lstrip("A")
+    cycle = _clean_text(item.get("cycle_identity") or intent.get("cycle_identity"))
+    matching = [record for record in records.values() if _cycle_exit_owner_matches(record, item)]
+    if any(cycle == record.get("cycle_identity") for record in matching):
+        return "CYCLE_EXIT_OLD_CYCLE_TOMBSTONE"
+    if not matching:
+        return ""
+    if len([record for record in matching if record.get("state") != "BASE_ADMITTED"]) > 1:
+        return "CYCLE_EXIT_MULTIPLE_OWNERS"
+    record = max(matching, key=lambda row: row.get("revision", 0))
+    if intent.get("routine_instance_id") != record.get("routine_instance_id"):
+        return "CYCLE_EXIT_OWNER_AMBIGUOUS"
+    if record.get("state") == "BASE_ADMITTED" and cycle == record.get("admitted_cycle_identity"):
+        return ""
+    is_base = intent.get("buy_phase") == "BASE" and intent.get("buy_round") == 1 and not intent.get("recovery_cycle")
+    if (record.get("state") == "BASE_ELIGIBLE" and cycle and is_base and cycle_exit_rearm_ready(record)
+            and item.get("account_no") == record.get("account_no")
+            and intent.get("routine_instance_id") == record.get("routine_instance_id")
+            and intent.get("cycle_exit_admission") == cycle_exit_base_token(record)):
+        return ""
+    return "CYCLE_EXIT_BUY_FENCED"
+
+
+def _cycle_exit_owner_matches(record: dict, subject: dict) -> bool:
+    return (record.get("code") == _clean_text(subject.get("code")).lstrip("A")
+            and (not subject.get("account_no") or record.get("account_no") == subject.get("account_no")))
+
+
+def cycle_exit_base_token(record: dict) -> dict:
+    return {"exit_key": cycle_exit_key(record), "exit_revision": record.get("revision"),
+            "true_input_identity": _as_dict(record.get("true_observation")).get("input_identity"),
+            "rules_identity": record.get("rules_identity"), "clock_instance_id": record.get("clock_instance_id")}
+
+
+def cycle_exit_rearm_ready(record: dict) -> bool:
+    false, true = _as_dict(record.get("false_observation")), _as_dict(record.get("true_observation"))
+    try:
+        return (record.get("clock_instance_id") == CYCLE_EXIT_CLOCK_INSTANCE_ID
+            and all(event.get("status") == "EVALUATED" and event.get("clock_instance_id") == CYCLE_EXIT_CLOCK_INSTANCE_ID
+                    and event.get("rules_identity") == record.get("rules_identity") for event in (false, true))
+            and false.get("buy_result") is False and true.get("buy_result") is True
+            and false["source_identity"] == true["source_identity"]
+            and false["input_identity"] != true["input_identity"]
+            and false["receive_sequence"] < true["receive_sequence"]
+            and false["started_monotonic"] < true["started_monotonic"]
+            and false["exit_revision_before"] >= record["completion_revision"]
+            and datetime.fromisoformat(record["completed_at"]) < datetime.fromisoformat(false["started_at"])
+            and datetime.fromisoformat(false["started_at"]) < datetime.fromisoformat(true["started_at"]))
+    except (KeyError, TypeError, ValueError):
+        return False
+
+
+def cycle_exit_fill_signature(fills: list, orders: list, record: dict) -> str:
+    owned = [row for row in orders if _cycle_exit_subject(row).get("cycle_identity") == record.get("cycle_identity")]
+    aliases = {_clean_text(row.get(key)) for row in owned for key in ("execution_id", "id", "order_id", "broker_order_no")}
+    aliases.discard("")
+    signature = {
+        "fills": [row for row in fills if any(_clean_text(row.get(key)) in aliases
+                   for key in ("execution_id", "order_queued_id", "order_id", "broker_order_no"))
+                   or row.get("cycle_identity") == record.get("cycle_identity")],
+        "orders": sorted(((_clean_text(row.get("id")), row.get("total_filled_quantity"),
+                           row.get("cumulative_filled_quantity")) for row in owned), key=str),
+    }
+    return hashlib.sha256(json.dumps(signature, sort_keys=True, default=str).encode()).hexdigest()
+
