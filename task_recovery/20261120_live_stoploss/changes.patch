-def _stoch_rsi_d_series(closes: list[float | None], history_window: int) -> list[float | None]:
-    """Fixed Wilder14 / stochastic14 / SMA3 / SMA3, on each causal window."""
-    def calculate(values):
-        rsi_values = rsi(values, 14)
-        raw = [None] * len(values)
-        for index in range(27, len(values)):
-            window = rsi_values[index - 13:index + 1]
-            if any(value is None or not isfinite(value) for value in window):
-                continue
-            low, high = min(window), max(window)
-            # Wilder rounding noise must not turn a flat RSI into an oversold value.
-            if high - low > 1e-12:
-                raw[index] = 100.0 * (window[-1] - low) / (high - low)
-            else:
-                raw[index] = 50.0
-        # Require consecutive observations; never smooth across unavailable data.
-        for _ in range(2):
-            smoothed = [None] * len(values)
-            for index in range(2, len(values)):
-                window = raw[index - 2:index + 1]
-                if all(value is not None for value in window):
-                    smoothed[index] = min(100.0, max(0.0, sum(window) / 3))
-            raw = smoothed
-        return raw
-
-    history_window = max(int(history_window), 32)
-    result = calculate(closes[:history_window])
-    for index in range(history_window, len(closes)):
-        result.append(calculate(closes[index - history_window + 1:index + 1])[-1])
-    return result
-
