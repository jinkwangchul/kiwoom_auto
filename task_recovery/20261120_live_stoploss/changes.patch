+        return False
+
+    values = (holding_qty, avg_price, current_price, stop_loss.get("loss_percent"))
+    if any(isinstance(value, bool) for value in values):
+        return False
+    try:
+        with localcontext():
+            quantity, average, price, loss_percent = (Decimal(str(value)) for value in values)
+    except (InvalidOperation, TypeError, ValueError, OverflowError):
+        return False
+    if not all(value.is_finite() and value > 0 for value in (quantity, average, price, loss_percent)):
+        return False
+    if loss_percent > 100:
+        return False
+    # Exact decimal threshold equality must survive binary float rounding.
+    return Fraction(price) <= Fraction(average) * (1 - Fraction(loss_percent) / 100)
+
+
+def _delay_index(candles: list[dict[str, Any]], delay_bar: int) -> int:
+    # delay_bar=0: 마지막 봉이 0봉.
+    # delay_bar=1: 마지막 봉에서 1봉 전이 신호봉이고, 현재 봉에서 신호를 발생시킨다.
+    return len(candles) - 1 - max(int(delay_bar or 0), 0)
