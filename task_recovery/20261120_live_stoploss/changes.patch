+def inspect_cycle_stop_exit(main_facts: dict, record: dict) -> dict:
+    """Use the cancellation/residual path for one already latched cycle."""
+    from execution_unfilled_cancel_eligibility import cancel_effect_state
+
+    code, account = record["code"], record["account_no"]
+    orders = [row for row in main_facts.get("orders", [])
+              if _text(row.get("code") or _preview(row).get("code")) == code
+              and _text(row.get("account_no") or _preview(row).get("account_no")) == account]
+    aliases = {_text(row.get("order_id")) for row in orders if isinstance(row.get("execution_request"), dict)}
+    orders = [row for row in orders if _text(row.get("id")) not in aliases]
+    def outcome(command, reason, **values):
+        return dict(command=command, reason=reason, code=code, **values)
+    for row in orders:
+        effect = cancel_effect_state(row)
+        if effect in {"UNCERTAIN", "REJECTED"}:
+            return outcome("STOP_AND_REVIEW", "CYCLE_STOP_CANCEL_UNCERTAIN")
+        if effect == "PENDING":
+            return outcome("WAIT", "CANCEL_EFFECT_PENDING")
+    final_orders = [row for row in orders if _intent(row).get("cycle_stop_exit") is True
+                    and _intent(row).get("cycle_identity") == record["cycle_identity"]]
+    if any(_intent(row).get("cycle_stop_exit") is True and (
+            not _text(_intent(row).get("cycle_identity"))
+            or _intent(row).get("routine_instance_id") != record["routine_instance_id"]
+            or (row.get("cycle_identity") and row["cycle_identity"] != _intent(row).get("cycle_identity"))) for row in orders):
+        return outcome("STOP_AND_REVIEW", "CYCLE_STOP_FINAL_OWNER_UNKNOWN")
+    for row in orders:
+        if _action(row) == "CANCEL":
+            continue
+        status = _text(row.get("status")).upper()
+        if status in {"DISPATCH_CLAIMED", "SEND_ATTEMPTED", "SEND_CALL_IN_PROGRESS", "SEND_CALL_ACCEPTED", "SEND_UNCERTAIN"}:
+            return outcome("WAIT", "CHEJAN_PENDING")
+        if status in _OPEN:
+            if row in final_orders:
+                return outcome("WAIT", "CYCLE_STOP_FINAL_SELL_PENDING")
+            if not _text(row.get("broker_order_no")):
+                return outcome("STOP_AND_REVIEW", "CYCLE_STOP_BROKER_ORDER_UNKNOWN")
+            return outcome("REQUEST_CANCEL", "CYCLE_STOP_CANCEL_OPEN_ORDER", proposal=deepcopy(row))
+        if status in _PRE_DISPATCH or status in {"PENDING", "PLANNED"}:
+            if row in final_orders:
+                return outcome("WAIT", "CYCLE_STOP_FINAL_SELL_PENDING")
+            if (status in {"ORDER_QUEUED", "APPROVED", "EXECUTABLE"} and row.get("send_order_called") is not True
