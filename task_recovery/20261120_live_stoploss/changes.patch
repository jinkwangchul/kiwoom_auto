+def evaluate_stop_loss(
+    config: dict[str, Any] | None = None,
+    *,
+    holding_qty: Any = None,
+    avg_price: Any = None,
+    current_price: Any = None,
+    tick_is_native: bool,
+    tick_is_fresh: bool,
+) -> bool:
+    """Pure sell.stop_loss predicate; callers must supply confirmed position data.
+
+    The caller must attest native tick provenance and freshness. No candles,
+    price fallback, fees, orders, or cycle latch are used here.
+    """
+    if not isinstance(config, dict):
+        return False
