+def update_cycle_exit(queue_path: str | Path, update: dict, *, expected_revision: int,
+                      stop_evidence_reader: Any = None) -> dict:
+    """CAS one routine-owned transition and fence pending BUY in the same lock."""
+    new_latch = False
+    def fresh_latch_reason(_data):
+        if not new_latch:
+            proposed = _as_dict(update.get("record"))
+            if proposed.get("state") in {"COMPLETE_WAIT_FALSE", "COMPLETE_WAIT_TRUE", "BASE_ELIGIBLE"}:
+                try:
+                    fills = json.loads((Path(queue_path).parent / "fills.json").read_text(encoding="utf-8"))["fills"]
+                    if cycle_exit_fill_signature(fills, _data["orders"], proposed) != proposed.get("completion_fill_signature"):
+                        return "CYCLE_EXIT_LATE_FILL_RECONCILIATION_REQUIRED"
+                except (OSError, KeyError, TypeError, ValueError):
+                    return "CYCLE_EXIT_FILL_EVIDENCE_UNAVAILABLE"
+            return ""
+        proposed = _as_dict(update.get("record"))
+        now, mono = cycle_exit_clocks()
+        current = stop_evidence_reader(proposed["code"], now_kst=now, now_monotonic=mono) if callable(stop_evidence_reader) else None
+        proof = proposed.get("stop_evidence")
+        now, mono = cycle_exit_clocks()
+        return "" if current == proof and stop_price_evidence_valid(proof, now_kst=now, now_monotonic=mono) else "STOP_NATIVE_EVIDENCE_EXPIRED_OR_CHANGED"
+
+    def mutate(data):
+        nonlocal new_latch
+        proposed = deepcopy(_as_dict(update.get("record")))
+        if any(not _clean_text(proposed.get(k)) for k in (
+                "account_no", "code", "routine_instance_id", "cycle_identity", "rules_identity")):
+            return {"blocked": _commit_blocked("cycle_exit", "CYCLE_EXIT_IDENTITY_MISSING")}
+        try:
+            records = cycle_exit_records(data)
+        except ValueError as exc:
+            return {"blocked": _commit_blocked("cycle_exit", str(exc))}
+        key = cycle_exit_key(proposed)
+        previous = records.get(key)
+        now, mono = cycle_exit_clocks()
+        if previous is None:
+            new_latch = True
+            proof = proposed.get("stop_evidence")
+            current = stop_evidence_reader(proposed["code"], now_kst=now, now_monotonic=mono) if callable(stop_evidence_reader) else None
+            if (proposed.get("state") != "EXITING" or not isinstance(proof, dict) or current != proof
+                    or not stop_price_evidence_valid(proof, now_kst=now, now_monotonic=mono)):
+                return {"blocked": _commit_blocked("cycle_exit", "STOP_NATIVE_EVIDENCE_EXPIRED_OR_CHANGED")}
+            proposed.update(latched_at=now.isoformat(), latch_revision=data["revision"] + 1,
+                            latch_rules_identity=proposed["rules_identity"])
+        else:
+            if previous.get("revision") != update.get("expected_exit_revision"):
+                return {"blocked": _commit_blocked("cycle_exit", "CYCLE_EXIT_REVISION_CHANGED")}
+            transitions = {"EXITING": {"EXITING", "COMPLETE_WAIT_FALSE", "REVIEW_REQUIRED"},
+                "COMPLETE_WAIT_FALSE": {"COMPLETE_WAIT_FALSE", "COMPLETE_WAIT_TRUE", "REVIEW_REQUIRED"},
+                "COMPLETE_WAIT_TRUE": {"COMPLETE_WAIT_TRUE", "COMPLETE_WAIT_FALSE", "BASE_ELIGIBLE", "REVIEW_REQUIRED"},
+                "BASE_ELIGIBLE": {"COMPLETE_WAIT_FALSE", "REVIEW_REQUIRED"},
+                "BASE_ADMITTED": {"REVIEW_REQUIRED"}, "REVIEW_REQUIRED": {"REVIEW_REQUIRED"}}
+            if proposed.get("state") not in transitions[previous["state"]]:
+                return {"blocked": _commit_blocked("cycle_exit", "CYCLE_EXIT_TRANSITION_INVALID")}
+            proposed = {**previous, **proposed}
+            for field in ("account_no", "code", "routine_instance_id", "cycle_identity", "latched_at", "latch_revision",
+                          "latch_rules_identity", "stop_evidence", "stop_result", "completed_at", "completion_revision",
+                          "completion_evidence", "completion_fill_signature"):
+                if field in previous:
+                    proposed[field] = deepcopy(previous[field])
+            if previous["state"] == "EXITING" and proposed["state"] == "COMPLETE_WAIT_FALSE":
+                proposed.update(completed_at=now.isoformat(), completion_revision=data["revision"] + 1,
+                                clock_instance_id=CYCLE_EXIT_CLOCK_INSTANCE_ID)
+        proposed["revision"] = data["revision"] + 1
+        container = data.setdefault("cycle_exits", {"version": 1, "records": {}})
+        container["records"][key] = proposed
+        for row in data["orders"]:
+            reason = cycle_exit_buy_block_reason(data, row)
+            if (reason and row.get("status") in {"ORDER_QUEUED", "APPROVED", "EXECUTABLE"} and row.get("send_order_called") is not True
+                    and not row.get("dispatch_claimed") and not row.get("broker_order_no")):
+                row.update(status="BLOCKED", execution_enabled=False, cycle_exit_block_reason=reason)
+        return {"data": data, "result": {"cycle_exit_record": proposed}}
+
+    return mutate_order_queue(queue_path, mutate, operation_name="cycle_exit", success_stage="cycle_exit_updated",
+                              next_stage="REVIEW_REQUIRED", expected_revision=expected_revision, pre_write=fresh_latch_reason)
+
