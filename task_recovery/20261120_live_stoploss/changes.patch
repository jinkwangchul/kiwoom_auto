+def _cycle_exit_admit_orders(data: dict, records: list[dict], queue_path: Path) -> str:
+    try:
+        exits = cycle_exit_records(data)
+    except ValueError as exc:
+        return str(exc)
+    buy_records = [row for row in records if _clean_text(_cycle_exit_subject(row).get("side")).upper() == "BUY"
+                   and _clean_text(_cycle_exit_subject(row).get("order_action") or "NEW").upper() != "CANCEL"]
+    relevant = [record for record in exits.values() if any(
+        _cycle_exit_owner_matches(record, _cycle_exit_subject(row)) for row in buy_records)]
+    for record in relevant:
+        if record.get("state") not in {"EXITING", "REVIEW_REQUIRED"}:
+            try:
+                fills = json.loads((queue_path.parent / "fills.json").read_text(encoding="utf-8"))["fills"]
+                if cycle_exit_fill_signature(fills, data["orders"], record) != record.get("completion_fill_signature"):
+                    return "CYCLE_EXIT_LATE_FILL_RECONCILIATION_REQUIRED"
+            except (OSError, ValueError, KeyError, TypeError):
+                return "CYCLE_EXIT_FILL_EVIDENCE_UNAVAILABLE"
+    for item in records:
+        reason = cycle_exit_buy_block_reason(data, item)
+        if reason:
+            return reason
+        subject = _cycle_exit_subject(item)
+        if _clean_text(subject.get("side")).upper() != "BUY":
+            continue
+        token = _as_dict(subject["execution_intent"].get("cycle_exit_admission"))
+        record = exits.get(token.get("exit_key"))
+        if isinstance(record, dict) and record.get("state") == "BASE_ELIGIBLE" and _cycle_exit_owner_matches(record, subject):
+            record.update(state="BASE_ADMITTED", admitted_cycle_identity=subject.get("cycle_identity"),
+                          admitted_source_signal_id=subject.get("source_signal_id"), revision=data["revision"] + 1)
+    return ""
