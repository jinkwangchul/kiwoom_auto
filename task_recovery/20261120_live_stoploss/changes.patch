+
+def _validation_minimal_series_targets(
+    config: dict[str, Any],
+) -> set[str] | None:
+    """Return exact replay dependencies, or None for a safe full fallback."""
+    buy_cfg = _section(config, "buy")
+    indicator_cfg = (
+        config.get("indicators")
+        if isinstance(config.get("indicators"), dict)
+        else config
+    )
+    filters = buy_cfg.get("filters")
+    if filters is not None and not isinstance(filters, dict):
+        return None
+    if isinstance(filters, dict):
+        supported_filter_names = set(BUY_FILTER_ORDER) | {"composite"}
+        for raw_name, filter_cfg in filters.items():
+            name = str(raw_name or "").strip().lower()
+            if name not in supported_filter_names:
+                if filter_cfg:
+                    return None
+                continue
+            if not isinstance(filter_cfg, dict):
+                return None
+    targets: set[str] = {"CLOSE", "VOLUME"}
+    if _buy_stoch_rsi_filter_config(buy_cfg).get("enabled", False):
+        targets.add("STOCH_RSI_D")
+
+    def add_condition(
+        condition: Any,
+        *,
+        include_disabled: bool = False,
+    ) -> bool:
+        if not isinstance(condition, dict):
+            return False
+        if not include_disabled and not bool(condition.get("enabled", True)):
+            return True
+        for field in ("target", "compare_target"):
+            raw = condition.get(field)
+            if raw is None or not str(raw).strip():
+                if field == "target":
+                    return False
+                continue
+            key = str(raw).strip().upper()
+            if key in _VALIDATION_DYNAMIC_SERIES:
+                continue
+            if key not in _VALIDATION_DIRECT_SERIES:
+                return False
+            targets.add(key)
+        return True
+
+    groups = buy_cfg.get("groups")
+    if isinstance(groups, list):
+        for group in groups:
+            if not isinstance(group, dict):
+                return None
+            if not bool(group.get("enabled", True)):
+                continue
+            conditions = group.get("conditions")
+            if not isinstance(conditions, list):
+                return None
+            if any(not add_condition(condition) for condition in conditions):
+                return None
+
+    rsi_filter = _buy_rsi_filter_config(config, buy_cfg)
+    if rsi_filter and bool(rsi_filter.get("enabled", True)):
+        rsi_condition = _first_rsi_condition(rsi_filter)
+        indicator_rsi = _indicator_rsi_config(config)
+        rsi_period = _safe_int(
+            rsi_condition.get("period", indicator_rsi.get("period", 14))
+        )
+        rsi_operator = _normalize_rsi_operator(
+            rsi_condition.get(
+                "operator",
+                rsi_condition.get(
+                    "compare_operator",
+                    rsi_condition.get("compare"),
+                ),
+            )
+        )
+        rsi_threshold = _safe_float(
+            rsi_condition.get("threshold", rsi_condition.get("value"))
+        )
+        if (
+            rsi_period is None
+            or rsi_period <= 0
+            or rsi_operator is None
+            or rsi_threshold is None
+        ):
+            return None
+        targets.add(f"_VALIDATION_RSI_{rsi_period}")
+
+    moving_average_filter = _buy_moving_average_filter_config(config, buy_cfg)
+    if moving_average_filter and bool(
+        moving_average_filter.get("enabled", True)
+    ):
+        ma_condition = _first_moving_average_condition(moving_average_filter)
+        ma_period = _safe_int(
+            ma_condition.get(
+                "period",
+                moving_average_filter.get("period", 60),
+            )
+        )
+        configured_ma_periods: set[int] = set()
+        raw_ma_periods = indicator_cfg.get("moving_averages", [5, 20, 60])
+        if not isinstance(raw_ma_periods, list):
+            raw_ma_periods = [5, 20, 60]
+        for raw_period in raw_ma_periods:
+            try:
+                configured_period = int(raw_period)
+            except (TypeError, ValueError):
+                continue
+            if configured_period > 0:
+                configured_ma_periods.add(configured_period)
+        if (
+            ma_period is None
+            or ma_period <= 0
+            or ma_period not in configured_ma_periods
+            or ma_condition.get("target", "CLOSE") != "CLOSE"
+            or ma_condition.get("compare_target", "MA") != "MA"
+        ):
+            return None
+        targets.add(f"MA{ma_period}")
+
+    price_compare_filter = canonicalize_buy_strategy_price_compare_filter(
+        _buy_price_compare_filter_config(config, buy_cfg)
+    )
+    if price_compare_filter and bool(
+        price_compare_filter.get("enabled", True)
+    ):
+        price_conditions = price_compare_filter.get("conditions")
+        if not isinstance(price_conditions, list) or not price_conditions:
+            return None
+        for condition in price_conditions:
+            if not isinstance(condition, dict):
+                return None
+            for field in ("target", "compare_target"):
+                key = str(condition.get(field) or "").strip().upper()
+                if not key:
+                    return None
+                if key in _VALIDATION_DYNAMIC_SERIES:
+                    continue
+                if key not in _VALIDATION_DIRECT_SERIES:
+                    return None
+                targets.add(key)
+
+    bollinger_filter = _buy_bollinger_filter_config(config, buy_cfg)
+    if bollinger_filter and bool(bollinger_filter.get("enabled", True)):
+        bollinger_conditions = bollinger_filter.get("conditions")
+        if (
+            not isinstance(bollinger_conditions, list)
+            or not bollinger_conditions
+            or not isinstance(bollinger_conditions[0], dict)
+        ):
+            return None
+        bollinger_condition = bollinger_conditions[0]
+        compare_target = str(
+            bollinger_condition.get("compare_target") or ""
+        ).strip().upper()
+        if compare_target == "BOLLINGER":
+            compare_target = "BOLLINGER_LOWER"
+        if compare_target not in {
+            "BOLLINGER_LOWER",
+            "BOLLINGER_UPPER",
+        }:
+            return None
+        targets.update({"BOLLINGER_LOWER", "BOLLINGER_UPPER"})
+
+    ocr_filter = _buy_ocr_filter_config(config, buy_cfg)
+    if ocr_filter and bool(ocr_filter.get("enabled", True)):
+        ocr_conditions = ocr_filter.get("conditions")
+        if not isinstance(ocr_conditions, list) or not ocr_conditions:
+            return None
+        for condition in ocr_conditions:
+            if not isinstance(condition, dict):
+                return None
+            runtime_condition = dict(condition)
+            runtime_condition.setdefault("target", "OSC")
+            if not add_condition(
+                runtime_condition,
+                include_disabled=True,
+            ):
+                return None
+
+    sell_cfg = _section(config, "sell")
+    for signal_cfg in _condition_sell_signals(sell_cfg).values():
+        if not isinstance(signal_cfg, dict):
+            return None
+        if not bool(signal_cfg.get("enabled", True)):
+            continue
+        groups = signal_cfg.get("groups")
+        if not isinstance(groups, list):
+            return None
+        for group in groups:
+            if not isinstance(group, dict):
+                return None
+            if not bool(group.get("enabled", True)):
+                continue
+            conditions = group.get("conditions")
+            if not isinstance(conditions, list):
+                return None
+            if any(not add_condition(condition) for condition in conditions):
+                return None
+
+    # The canonical full builder always parses MACD, RSI, and Bollinger
+    # parameters even when a particular replay rule does not consume them.
+    # Preserve its fail-closed errors instead of silently substituting defaults.
+    macd_cfg = (
+        indicator_cfg.get("macd")
+        if isinstance(indicator_cfg.get("macd"), dict)
+        else {}
+    )
+    rsi_cfg = (
+        indicator_cfg.get("rsi")
+        if isinstance(indicator_cfg.get("rsi"), dict)
+        else {}
+    )
+    bollinger_cfg = (
+        indicator_cfg.get("bollinger")
+        if isinstance(indicator_cfg.get("bollinger"), dict)
+        else {}
+    )
+    try:
+        int(macd_cfg.get("fast", 12) or 12)
+        int(macd_cfg.get("slow", 26) or 26)
+        int(macd_cfg.get("signal", 9) or 9)
+        int(rsi_cfg.get("period", 14) or 14)
+        int(bollinger_cfg.get("period", 20) or 20)
+    except (TypeError, ValueError):
+        return None
+
+    return targets
+
+
+@dataclass(frozen=True, slots=True, eq=False)
+class _ValidationRSIProvenance:
+    """Ephemeral evidence from one minimal build, never a cross-replay cache."""
+
+    key: str
+    period: int
+    history_window: int
+    candles: list[dict[str, Any]]
+    candle_snapshot: list[dict[str, Any]]
+    series: list[float | None]
+    values: tuple[float | None, ...]
+
+    def matches(self, candles, key, period, history_window, series) -> bool:
+        try:
+            return (
+                self.key == key
+                and self.period == period
+                and self.history_window == history_window
+                and self.candles is candles
+                and self.series is series
+                and len(series) == len(candles) == len(self.values)
+                and candles == self.candle_snapshot
+                and tuple(series) == self.values
+            )
+        except Exception:
+            return False
+
+
+def build_indicator_follow_validation_series(
+    candles: list[dict[str, Any]],
+    config: dict[str, Any] | None = None,
+    *,
+    _bollinger_calculator: Callable[
+        [list[float | None], int, float],
+        tuple[list[float | None], list[float | None], list[float | None]],
+    ] | None = None,
+    _rsi_provenance_out: list[_ValidationRSIProvenance] | None = None,
+) -> dict[str, list[float | None]]:
+    """Build only series proven necessary for exact validation replay.
+
+    Unsupported or filter-rich configurations fail safely to the canonical
+    full builder instead of guessing dependencies.
+    """
+    cfg = config if isinstance(config, dict) else DEFAULT_INDICATOR_FOLLOW_CONFIG
+    targets = _validation_minimal_series_targets(cfg)
+    if targets is None:
+        return build_indicator_follow_base_series(candles, cfg)
+
+    history_window = indicator_history_target_bars_from_rules(cfg)
+    closes = close_prices(candles)
+    series_map: dict[str, list[float | None]] = {
+        "CLOSE": closes,
+    }
+    if "STOCH_RSI_D" in targets:
+        series_map["STOCH_RSI_D"] = _stoch_rsi_d_series(closes, history_window)
+    if "VOLUME" in targets:
+        from engines.indicator_engine import volumes
+        series_map["VOLUME"] = volumes(candles)
+
+    indicator_cfg = (
+        cfg.get("indicators")
+        if isinstance(cfg.get("indicators"), dict)
+        else cfg
+    )
+
+    validation_rsi_periods = sorted(
+        int(target.removeprefix("_VALIDATION_RSI_"))
+        for target in targets
+        if target.startswith("_VALIDATION_RSI_")
+        and target.removeprefix("_VALIDATION_RSI_").isdigit()
+    )
+    for period in validation_rsi_periods:
+        series_map[f"_VALIDATION_RSI_{period}"] = rsi_causal_history(
+            closes,
+            period,
+            history_window,
+        )
+        if _rsi_provenance_out is not None:
+            # Capture only the result just calculated here. If evidence cannot
+            # be detached, admission retains its canonical recalculation path.
+            try:
+                key = f"_VALIDATION_RSI_{period}"
+                _rsi_provenance_out.append(_ValidationRSIProvenance(
+                    key, period, history_window, candles, deepcopy(candles),
+                    series_map[key], tuple(series_map[key]),
+                ))
+            except Exception:
+                pass
+
+    moving_average_periods = sorted(
+        int(target[2:])
+        for target in targets
+        if target.startswith("MA") and target[2:].isdigit()
+    )
+    if moving_average_periods:
+        from engines.indicator_engine import simple_ma
+
+        for period in moving_average_periods:
+            series_map[f"MA{period}"] = simple_ma(closes, period)
+
+    if targets & {"BOLLINGER_LOWER", "BOLLINGER_UPPER"}:
+        from engines.indicator_engine import bollinger_band
+
+        bollinger_cfg = (
+            indicator_cfg.get("bollinger")
+            if isinstance(indicator_cfg.get("bollinger"), dict)
+            else {}
+        )
+        bollinger_period = _safe_int(bollinger_cfg.get("period")) or 20
+        bollinger_std = _safe_float(bollinger_cfg.get("std", 2.0)) or 2.0
+        calculate_bollinger = (
+            bollinger_band if _bollinger_calculator is None else _bollinger_calculator
+        )
+        lower, _middle, upper = calculate_bollinger(
+            closes,
+            bollinger_period,
+            bollinger_std,
+        )
+        series_map["BOLLINGER_LOWER"] = lower
+        series_map["BOLLINGER_UPPER"] = upper
+
+    if targets & {"MACD", "SIGNAL", "OSC"}:
+        macd_cfg = (
+            indicator_cfg.get("macd")
+            if isinstance(indicator_cfg.get("macd"), dict)
+            else {}
+        )
+        fast = _safe_int(macd_cfg.get("fast")) or 12
+        slow = _safe_int(macd_cfg.get("slow")) or 26
+        signal_period = _safe_int(macd_cfg.get("signal")) or 9
+        macd_line, signal_line, osc = macd_series_causal_history(
+            closes,
+            fast,
+            slow,
+            signal_period,
+            history_window,
+        )
+        series_map["MACD"] = macd_line
+        series_map["SIGNAL"] = signal_line
+        series_map["OSC"] = osc
+
+    rsi_cfg = (
+        indicator_cfg.get("rsi")
+        if isinstance(indicator_cfg.get("rsi"), dict)
+        else {}
+    )
+    rsi_period = _safe_int(rsi_cfg.get("period")) or 14
+    if "RSI" in targets:
+        series_map["RSI"] = rsi_causal_history(
+            closes,
+            rsi_period,
+            history_window,
+        )
+
+    for period in _configured_sell_rsi_periods(cfg):
+        series_map[_rsi_runtime_series_key(period)] = rsi_causal_history(
+            closes,
+            period,
+            history_window,
+        )
+    return series_map
+
+
+def _aggregate_sell_signal_policies(
+    sell_cfg: dict[str, Any],
+    condition_sell_signals: dict[str, dict[str, Any]],
+    condition_sell_passed: dict[str, bool],
+    condition_sell_truth: dict[str, bool | None],
+    profit_rate_sell_cfg: dict[str, Any],
+    profit_passed: bool,
+    sell_index: int,
+    *,
+    readiness_safe: bool = False,
+) -> tuple:
+    """Use one format-aware SELL policy aggregation for routine and replay."""
+    active_sell_names: list[str] = []
+    for signal_name, signal_cfg in condition_sell_signals.items():
+        if bool(signal_cfg.get("enabled", True)):
+            active_sell_names.append(signal_name)
+    if isinstance(profit_rate_sell_cfg, dict) and profit_rate_sell_cfg.get("enabled", False):
+        active_sell_names.append("profit_rate_sell")
+
+    unified_ui_names = {f"ui_filter_{letter}" for letter in "abcdefghi"}
+    legacy_ui_names = {"ui_condition_a", "ui_condition_b", "ui_condition_c"}
+    ui_signal_names = legacy_ui_names | unified_ui_names
+    independent_sell_names = [
+        name for name in active_sell_names if name not in ui_signal_names
+    ]
+    aggregation_sell_names = list(independent_sell_names)
+    aggregation_group_signal_names = [
+        name for name in independent_sell_names if name != "profit_rate_sell"
+    ]
+    causal_condition_sell_names = list(aggregation_group_signal_names)
+    unified_mode = bool(set(condition_sell_signals) & unified_ui_names)
+    ui_expression_passed: bool | None = False if unified_mode else None
+    ui_expression_contract: dict[str, Any] | None = None
+    ui_expression_values: dict[str, bool | None] = {}
+    ui_expression_results: dict[str, bool] = {}
+    ui_signal_expressions: list[dict[str, Any]] = []
+    for expression_names, expression_name, is_unified in (
+        (legacy_ui_names, "ui_signal_expression", False),
+        (unified_ui_names, "ui_filter_expression", True),
+    ):
+        active_ui_signal_names = [
+            name for name in condition_sell_signals
+            if name in expression_names and (is_unified or name in active_sell_names)
+        ]
+        if not active_ui_signal_names:
+            continue
+        if is_unified:
+            aggregation_sell_names.append(expression_name)
+            ui_expression_results[expression_name] = False
+            ui_expression_passed = False
+            ui_expression_contract = None
+            ui_expression_values = {}
+        expression_contracts = [
+            condition_sell_signals[name].get("signal_expression")
+            for name in active_ui_signal_names
+            if isinstance(condition_sell_signals.get(name), dict)
+        ]
+        if (
+            expression_contracts
+            and len(expression_contracts) == len(active_ui_signal_names)
+            and all(isinstance(value, dict) for value in expression_contracts)
+            and all(value == expression_contracts[0] for value in expression_contracts[1:])
+        ):
+            canonical_expression = expression_contracts[0]
+            if is_unified:
+                parsed = parse_condition_expression(
+                    canonical_expression.get("source"), allowed_identifiers=set("ABCDEFGHI"),
+                    allow_duplicate_identifiers=False,
+                )
+                if (
+                    canonical_expression.get("format") != "A_I_V1"
+                    or not parsed.get("ok")
+                    or any(canonical_expression.get(key) != parsed.get(key)
+                           for key in ("ast", "identifiers", "normalized"))
+                    or canonical_expression.get("identifier_map") != {
+                        letter: f"ui_filter_{letter.lower()}" for letter in "ABCDEFGHI"}
+                ):
+                    canonical_expression = {}
+            elif canonical_expression.get("format") == "A_I_V1":
+                canonical_expression = {}
+            identifier_map = canonical_expression.get("identifier_map")
+            identifiers = canonical_expression.get("identifiers")
+            expression_ast = canonical_expression.get("ast")
+            if (
+                isinstance(identifier_map, dict)
+                and isinstance(identifiers, list)
+                and identifiers
+                and isinstance(expression_ast, dict)
+            ):
+                expression_values: dict[str, bool | None] = {}
+                referenced_signal_names: list[str] = []
+                for raw_identifier in identifiers:
+                    identifier = str(raw_identifier or "").strip().upper()
+                    signal_name = str(identifier_map.get(identifier) or "").strip()
+                    if signal_name not in condition_sell_passed or signal_name not in expression_names:
+                        expression_values = {}
+                        referenced_signal_names = []
+                        break
+                    expression_values[identifier] = (
+                        condition_sell_truth[signal_name]
+                        if readiness_safe else bool(condition_sell_passed[signal_name]))
+                    if signal_name not in referenced_signal_names:
+                        referenced_signal_names.append(signal_name)
+                if expression_values:
+                    ui_expression_contract = canonical_expression
+                    ui_expression_values = dict(expression_values)
+                    if not is_unified:
+                        # Only the legacy A/B/C expression replaces legacy MACD.
+                        aggregation_sell_names = [
+                            name for name in aggregation_sell_names if name != "macd_sell"
+                        ]
+                        aggregation_group_signal_names = [
+                            name for name in aggregation_group_signal_names if name != "macd_sell"
+                        ]
+                        causal_condition_sell_names = [
+                            name for name in causal_condition_sell_names if name != "macd_sell"
+                        ]
+                    evaluated = evaluate_condition_expression(
+                        expression_ast,
+                        expression_values,
+                        current_identity=sell_index,
+                    )
+                    ui_expression_passed = (
+                        bool(evaluated.get("passed")) if evaluated.get("ok") else False
+                    )
+                    ui_signal_expressions.append({
+                        "contract": canonical_expression,
+                        "values": expression_values,
+                        "result": ui_expression_passed,
+                    })
+                    ui_expression_results[expression_name] = ui_expression_passed
+                    if expression_name not in aggregation_sell_names:
+                        aggregation_sell_names.append(expression_name)
+                    aggregation_group_signal_names.extend(referenced_signal_names)
+                    if ui_expression_passed:
+                        causal_condition_sell_names.extend(referenced_signal_names)
+
+    sell_logic = _logic(sell_cfg.get("signal_logic", "OR"), "OR")
+    if not aggregation_sell_names:
+        sell_passed = False
+    elif sell_logic == "AND":
+        signal_pass_map = dict(condition_sell_passed)
+        signal_pass_map["profit_rate_sell"] = profit_passed
+        signal_pass_map.update(ui_expression_results)
+        sell_passed = all(signal_pass_map.get(name, False) for name in aggregation_sell_names)
+    else:
+        signal_pass_map = dict(condition_sell_passed)
+        signal_pass_map.update(ui_expression_results)
+        sell_passed = any(signal_pass_map.get(name, False) for name in aggregation_sell_names) or profit_passed
+
+    return (
+        sell_passed, sell_logic, aggregation_group_signal_names,
+        causal_condition_sell_names, ui_expression_contract,
+        ui_expression_values, ui_expression_passed, ui_signal_expressions,
+    )
+
+
+def evaluate_indicator_follow_routine(
+    candles: list[dict[str, Any]],
+    config: dict[str, Any] | None = None,
+    context: dict[str, Any] | None = None,
+    *,
+    _base_series_map: dict[str, list[float | None]] | None = None,
+    _signal_price_series: list[float | None] | None = None,
+    readiness_safe: bool = False,
+) -> RoutineSignal:
+    """MACD 루틴을 평가한다.
+
+    반환 원칙:
+    - BUY / SELL 조건 충족 시에만 공식 주문신호를 반환한다.
+    - 조건 미충족, 데이터 부족, 루틴 비활성은 signal=None으로 반환한다.
+    - 비신호를 별도 주문신호로 승격하지 않는다.
+    """
+    cfg = config if isinstance(config, dict) else DEFAULT_INDICATOR_FOLLOW_CONFIG
+    observer = context.get("decision_trace_observer") if isinstance(context, dict) else None
+    evaluate_side = str(
+        context.get("_indicator_follow_evaluate_side") or ""
+    ).strip().upper() if isinstance(context, dict) else ""
+    if isinstance(context, dict) and isinstance(context.get("candles"), list):
+        candles = context["candles"]
+    production_observer = context.get("_production_buy_condition_observer") if isinstance(context, dict) else None
+    production_truth = {} if callable(production_observer) else None
+    buy_observer = context.get("_validation_buy_condition_observer") if isinstance(context, dict) else None
+
+    if not cfg.get("enabled", True):
+        _observe_production_buy(production_observer, candles, None, None)
+        _observe_validation_buy(buy_observer, candles, None, None, "UNEVALUATED")
+        return RoutineSignal(None, "루틴 비활성", [], [], -1, 0)
+
+    if not candles or (not readiness_safe and len(candles) < 3):
+        _observe_production_buy(production_observer, candles, None, None)
+        _observe_validation_buy(buy_observer, candles, None, None)
+        return RoutineSignal(None, "봉데이터 부족", [], [], -1, 0)
+
+    if _base_series_map is None:
+        series_map = build_indicator_follow_base_series(candles, cfg)
+    else:
+        if not isinstance(_base_series_map, dict) or any(
+            not isinstance(key, str) or not isinstance(values, list)
+            for key, values in _base_series_map.items()
+        ):
+            raise TypeError("_base_series_map must be an indicator series mapping")
+        series_map = dict(_base_series_map)
+    if readiness_safe:
+        series_map = mask_validation_indicator_readiness(series_map, cfg)
+    readiness = {} if readiness_safe else None
+    _enrich_price_compare_series(
+        series_map, context,
+        **({"_signal_price_series": _signal_price_series}
+           if _signal_price_series is not None else {}),
+    )
+
+    buy_cfg = _section(cfg, "buy")
+    sell_cfg = _section(cfg, "sell")
+    macd_sell_cfg = _macd_sell_section(sell_cfg)
+    profit_rate_sell_cfg = _profit_rate_sell_section(sell_cfg)
+    condition_sell_signals = _condition_sell_signals(sell_cfg)
+
+    buy_ocr_cfg = _buy_ocr_filter_config(cfg, buy_cfg)
+    buy_delay = int(
+        buy_ocr_cfg.get("order_delay_bars", buy_cfg.get("delay_bar", 1)) or 0
+    )
+    sell_delay = int(macd_sell_cfg.get("delay_bar", sell_cfg.get("delay_bar", 1)) or 0)
+
