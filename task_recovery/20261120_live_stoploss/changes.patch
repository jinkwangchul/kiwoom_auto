+        if _production_truth is not None:
+            _production_truth["price_compare"] = True
+        return True, _price_compare_detail(
+            enabled=False,
+            target=None,
+            operator=None,
+            compare_target=None,
+            value=None,
+            passed=True,
+            reason="disabled",
+            evaluation_index=evaluation_index,
+        )
+
+    conditions = filter_cfg.get("conditions")
+    if not isinstance(conditions, list) or not conditions:
+        if _readiness is not None:
+            _readiness["_validation_invalid_price_compare"] = True
+        if _production_truth is not None:
+            _production_truth["price_compare"] = None
+        return False, _price_compare_detail(
+            enabled=True,
+            target=None,
+            operator=None,
+            compare_target=None,
+            value=None,
+            passed=False,
+            reason="missing_conditions",
+            evaluation_index=evaluation_index,
+        )
+
+    logic = _logic(filter_cfg.get("conditions_logic", filter_cfg.get("logic", "AND")), "AND")
+    condition_results = []
+    for condition_index, condition in enumerate(conditions):
+        if not isinstance(condition, dict):
+            continue
+        target = condition.get("target")
+        compare_target = condition.get("compare_target")
+        operator = condition.get("operator")
+        if target not in BUY_STRATEGY_PRICE_AXES or compare_target not in BUY_STRATEGY_PRICE_AXES:
+            if _readiness is not None:
+                _readiness["_validation_invalid_price_compare"] = True
+            if _production_truth is not None:
+                _production_truth["price_compare"] = None
+            return False, _price_compare_detail(
+                enabled=True,
+                target=target,
+                operator=operator,
+                compare_target=compare_target,
+                value=condition.get("value"),
+                passed=False,
+                reason="unsupported_target",
+                evaluation_index=evaluation_index,
+            )
+        if _readiness is None and (_series_value_at(series_map, target, evaluation_index) is None or _series_value_at(series_map, compare_target, evaluation_index) is None):
+            if _production_truth is not None:
+                _production_truth["price_compare"] = None
+            return False, _price_compare_detail(
+                enabled=True,
+                target=target,
+                operator=operator,
+                compare_target=compare_target,
+                value=condition.get("value"),
+                passed=False,
+                reason="insufficient_data",
+                evaluation_index=evaluation_index,
+            )
+        result = evaluate_condition(
+            condition,
+            series_map,
+            evaluation_index,
+            production_conditions if production_conditions is not None else observer,
+            f"buy.filters.price_compare.conditions[{condition_index}]",
+            readiness_safe=_readiness is not None,
+        )
+        condition_results.append((condition, result))
+
+    if not condition_results:
+        if _readiness is not None:
+            _readiness["_validation_invalid_price_compare"] = True
+        if _production_truth is not None:
+            _production_truth["price_compare"] = None
+        return False, _price_compare_detail(
+            enabled=True,
+            target=None,
+            operator=None,
+            compare_target=None,
+            value=None,
+            passed=False,
+            reason="missing_conditions",
+            evaluation_index=evaluation_index,
+        )
+
+    passed = all(result.passed for _, result in condition_results) if logic == "AND" else any(
+        result.passed for _, result in condition_results
+    )
+    if _readiness is not None:
+        truth = condition_results_truth([result for _, result in condition_results], logic)
+        passed = truth is True
+        _readiness["price_compare"] = truth is not None
+    first_condition = condition_results[0][0]
+    if _production_truth is not None:
+        _production_truth["price_compare"] = _buy_truth([production_conditions._condition_truth(condition, production_conditions.conditions.get(f"buy.filters.price_compare.conditions[{index}]")) for index, condition in enumerate(conditions)], logic)
+    return passed, _price_compare_detail(
+        enabled=True,
+        target=first_condition.get("target"),
+        operator=first_condition.get("operator"),
+        compare_target=first_condition.get("compare_target"),
+        value=first_condition.get("value"),
+        passed=passed,
+        reason="matched" if passed else "not_matched",
+        evaluation_index=evaluation_index,
+    )
+
+
+def _buy_bollinger_filter_config(config: dict[str, Any], buy_cfg: dict[str, Any]) -> dict[str, Any]:
+    """Get Bollinger filter configuration from buy filters."""
+    filters = buy_cfg.get("filters")
+    if isinstance(filters, dict) and isinstance(filters.get("bollinger"), dict):
+        return filters["bollinger"]
+    return {}
+
+
+def _bollinger_detail(
+    *,
+    enabled: bool,
+    operator: Any,
+    value: Any,
+    close_price: Any,
+    bollinger_value: Any,
+    passed: bool,
+    reason: str,
+    evaluation_index: int,
+    compare_target: Any = None,
+    threshold: Any = None,
+) -> str:
+    return (
+        "filter_type=BOLLINGER "
+        f"enabled={enabled} "
+        "target=CLOSE "
+        f"compare_target={compare_target} "
+        f"operator={operator} "
+        f"value={value} "
+        f"close_price={close_price} "
+        f"bollinger_value={bollinger_value} "
+        f"threshold={threshold} "
+        f"passed={passed} "
+        f"reason={reason} "
+        f"evaluation_index={evaluation_index}"
+    )
+
+
+def _evaluate_buy_bollinger_filter(
+    config: dict[str, Any],
+    buy_cfg: dict[str, Any],
+    series_map: dict[str, list[float | None]],
+    evaluation_index: int,
+    *,
+    _readiness: dict | None = None,
+    _production_truth: dict | None = None,
+) -> tuple[bool, str | None]:
+    """Evaluate BUY Bollinger filter.
+
+    The Bollinger filter compares close against a signed percent offset from
+    the explicitly selected upper or lower Bollinger Band.
+    """
+    filter_cfg = _buy_bollinger_filter_config(config, buy_cfg)
+    if not filter_cfg:
+        if _production_truth is not None:
+            _production_truth["bollinger"] = True
+        return True, None
+
+    conditions = filter_cfg.get("conditions")
+    if not isinstance(conditions, list) or not conditions:
+        if _readiness is not None:
+            _readiness["_validation_invalid_bollinger"] = True
+        if _production_truth is not None:
+            _production_truth["bollinger"] = None
+        return False, _bollinger_detail(
+            enabled=True,
+            operator=None,
+            value=None,
+            close_price=None,
+            bollinger_value=None,
+            passed=False,
+            reason="missing_conditions",
+            evaluation_index=evaluation_index,
+        )
+
+    # Process only the first condition (similar to other filters)
+    condition = conditions[0] if conditions else {}
+    if not isinstance(condition, dict):
+        if _readiness is not None:
+            _readiness["_validation_invalid_bollinger"] = True
+        if _production_truth is not None:
+            _production_truth["bollinger"] = None
+        return False, _bollinger_detail(
+            enabled=True,
+            operator=None,
+            value=None,
+            close_price=None,
+            bollinger_value=None,
+            passed=False,
+            reason="invalid_condition",
+            evaluation_index=evaluation_index,
+        )
+
+    enabled = bool(filter_cfg.get("enabled", True))
+    if not enabled:
+        if _production_truth is not None:
+            _production_truth["bollinger"] = True
+        return True, _bollinger_detail(
+            enabled=False,
+            operator=None,
+            value=None,
+            close_price=None,
+            bollinger_value=None,
+            passed=True,
+            reason="disabled",
+            evaluation_index=evaluation_index,
+        )
+
+    operator = str(condition.get("operator", "")).strip().upper()
+    raw_value = condition.get("value")
+    compare_target = condition.get("compare_target")
+    raw_period = condition.get("period")
+
+    # Validate optional per-condition period override.
+    # The band period is taken from config; if a condition supplies its own
+    # period it must be a positive integer, otherwise the filter is blocked.
+    if raw_period is not None:
+        period = _safe_int(raw_period)
+        if period is None or period <= 0:
+            if _readiness is not None:
+                _readiness["_validation_invalid_bollinger"] = True
+            if _production_truth is not None:
+                _production_truth["bollinger"] = None
+            return False, _bollinger_detail(
+                enabled=True,
+                operator=operator,
+                value=raw_value,
+                close_price=None,
+                bollinger_value=None,
+                passed=False,
+                reason="invalid_period",
+                evaluation_index=evaluation_index,
+            )
+
+    # Validate operator
+    if operator not in {">", ">=", "<", "<="}:
+        if _readiness is not None:
+            _readiness["_validation_invalid_bollinger"] = True
+        if _production_truth is not None:
+            _production_truth["bollinger"] = None
+        return False, _bollinger_detail(
+            enabled=True,
+            operator=operator,
+            value=raw_value,
+            close_price=None,
+            bollinger_value=None,
+            passed=False,
+            reason="unsupported_operator",
+            evaluation_index=evaluation_index,
+            compare_target=compare_target,
+        )
+
+    compare_target = str(compare_target or "").strip().upper()
+    if compare_target == "BOLLINGER":
+        compare_target = "BOLLINGER_LOWER"
+    if compare_target not in {"BOLLINGER_LOWER", "BOLLINGER_UPPER"}:
+        if _readiness is not None:
+            _readiness["_validation_invalid_bollinger"] = True
+        if _production_truth is not None:
+            _production_truth["bollinger"] = None
+        return False, _bollinger_detail(
+            enabled=True,
+            operator=operator,
+            value=raw_value,
+            close_price=None,
+            bollinger_value=None,
+            passed=False,
+            reason="unsupported_compare_target",
+            evaluation_index=evaluation_index,
+            compare_target=compare_target,
+        )
+
+    # Validate value (offset from the band must be numeric when supplied)
+    value = _safe_float(raw_value)
+    if raw_value is not None and value is None:
+        if _readiness is not None:
+            _readiness["_validation_invalid_bollinger"] = True
+        if _production_truth is not None:
+            _production_truth["bollinger"] = None
+        return False, _bollinger_detail(
+            enabled=True,
+            operator=operator,
+            value=raw_value,
+            close_price=None,
+            bollinger_value=None,
+            passed=False,
+            reason="invalid_value",
+            evaluation_index=evaluation_index,
+        )
+
+    # Get close price
+    close_series = series_map.get("CLOSE")
+    close_price = close_series[evaluation_index] if isinstance(close_series, list) and 0 <= evaluation_index < len(close_series) else None
+
+    # Get Bollinger band value
+    bollinger_series = series_map.get(compare_target)
+    bollinger_value = bollinger_series[evaluation_index] if isinstance(bollinger_series, list) and 0 <= evaluation_index < len(bollinger_series) else None
+
+    if close_price is None or bollinger_value is None:
+        if _readiness is not None:
+            _readiness["bollinger"] = False
+        if _production_truth is not None:
+            _production_truth["bollinger"] = None
+        return False, _bollinger_detail(
+            enabled=True,
+            operator=operator,
+            value=raw_value,
+            close_price=close_price,
+            bollinger_value=bollinger_value,
+            passed=False,
+            reason="insufficient_data",
+            evaluation_index=evaluation_index,
+            compare_target=compare_target,
+        )
+
+    signed_percent = value if value is not None else 0.0
+    threshold = round(
+        bollinger_value * (1.0 + signed_percent / 100.0),
+        8,
+    )
+
+    # Evaluate the condition
+    if operator == ">=":
+        passed = close_price >= threshold
+    elif operator == ">":
+        passed = close_price > threshold
+    elif operator == "<=":
+        passed = close_price <= threshold
+    elif operator == "<":
+        passed = close_price < threshold
+    else:
+        passed = False
+
+    if _production_truth is not None:
+        _production_truth["bollinger"] = (bool(passed) if isfinite(close_price) and isfinite(bollinger_value) and isfinite(threshold) else None)
+    return passed, _bollinger_detail(
+        enabled=True,
+        operator=operator,
+        value=raw_value,
+        close_price=round(close_price, 8),
+        bollinger_value=round(bollinger_value, 8),
+        passed=passed,
+        reason="matched" if passed else "not_matched",
+        evaluation_index=evaluation_index,
+        compare_target=compare_target,
+        threshold=round(threshold, 8),
+    )
+
+
+def _buy_ocr_filter_config(config: dict[str, Any], buy_cfg: dict[str, Any]) -> dict[str, Any]:
+    filters = buy_cfg.get("filters")
+    if isinstance(filters, dict) and isinstance(filters.get("ocr"), dict):
+        normalized = deepcopy(filters["ocr"])
+        conditions = normalized.get("conditions")
+        if isinstance(conditions, list):
+            normalized["conditions"] = _normalize_ocr_transition_threshold_conditions(
+                conditions, allow_v5_buy_current_bar=True, _already_detached=True,
+            )
+        return normalized
+    return {}
+
+
+def _ocr_detail(
+    *,
+    enabled: bool,
+    logic: Any,
+    passed: bool,
+    reason: str,
+    evaluation_index: int,
+    condition_details: list[str] | None = None,
+) -> str:
+    detail = (
+        "filter_type=OCR "
+        f"enabled={enabled} "
+        f"logic={logic} "
+        f"passed={passed} "
+        f"reason={reason} "
+        f"evaluation_index={evaluation_index}"
+    )
+    if condition_details:
+        detail += " condition_details=" + "|".join(str(item).replace(" ", "_") for item in condition_details)
+    return detail
+
+
+def _ocr_condition_data_available(
+    condition: dict[str, Any],
+    series_map: dict[str, list[float | None]],
+    evaluation_index: int,
+) -> bool:
+    target = str(condition.get("target", "OSC") or "OSC").strip().upper()
+    series = series_map.get(target)
+    if not isinstance(series, list):
+        return False
+
+    operator = str(condition.get("operator", "") or "").strip().upper()
+    bar_offset = _safe_int(condition.get("bar_offset", 0))
+    if bar_offset is None or bar_offset < 0:
+        return False
+    effective_index = evaluation_index - bar_offset
+    required_indexes = [effective_index]
+    if operator in {"TURN_UP", "TURN_DOWN"}:
+        required_indexes.extend([effective_index - 1, effective_index - 2])
+    elif operator in {"TREND_UP", "TREND_DOWN", "CROSS_UP", "CROSS_DOWN", "ZERO_CROSS_UP", "ZERO_CROSS_DOWN"}:
+        required_indexes.append(effective_index - 1)
+
+    for index in required_indexes:
+        if index < 0:
+            return False
+        if index >= len(series) or series[index] is None:
+            return False
+
+    compare_target = condition.get("compare_target")
+    if compare_target:
+        compare_condition = dict(condition)
+        compare_key = "MA"
+        if str(compare_target).strip().upper() == "MA":
+            period = _safe_int(condition.get("period"))
+            if period is None or period <= 0:
+                return False
+            compare_key = f"MA{period}"
+        else:
+            compare_key = str(compare_target).strip().upper()
+        compare_series = series_map.get(compare_key)
+        if not isinstance(compare_series, list):
+            return False
+        compare_indexes = [effective_index]
+        if operator in {"CROSS_UP", "CROSS_DOWN"}:
+            compare_indexes.append(effective_index - 1)
+        for index in compare_indexes:
+            if index < 0:
+                return False
+            if index >= len(compare_series) or compare_series[index] is None:
+                return False
+        compare_condition["compare_target"] = compare_target
+
+    return True
+
+
+def _ocr_condition_error(
+    condition: dict[str, Any],
+    series_map: dict[str, list[float | None]],
+    evaluation_index: int,
+) -> str | None:
+    target = str(condition.get("target", "OSC") or "OSC").strip().upper()
+    operator = str(condition.get("operator", "") or "").strip().upper()
+    supported_operators = {
+        "TURN_UP", "TURN_DOWN", "TREND_UP", "TREND_DOWN",
+        "CROSS_UP", "CROSS_DOWN", "ZERO_CROSS_UP", "ZERO_CROSS_DOWN",
+        ">", ">=", "<", "<=", "=", "==", "GT", "GTE", "LT", "LTE", "EQ", "ABOVE", "BELOW",
+    }
+
+    if operator not in supported_operators:
+        return "unsupported_operator"
+    if target not in series_map:
+        return "unsupported_target"
+    if condition.get("compare_target") == "MA":
+        period = _safe_int(condition.get("period"))
+        if period is None or period <= 0:
+            return "invalid_period"
+    if operator in {">", ">=", "<", "<=", "=", "==", "GT", "GTE", "LT", "LTE", "EQ", "ABOVE", "BELOW"} and not condition.get("compare_target"):
+        if _safe_float(condition.get("value")) is None:
+            return "invalid_value"
+    if not _ocr_condition_data_available(condition, series_map, evaluation_index):
+        return "insufficient_data"
+    return None
+
+
+def _evaluate_buy_ocr_filter(
+    config: dict[str, Any],
+    buy_cfg: dict[str, Any],
+    series_map: dict[str, list[float | None]],
+    evaluation_index: int,
+    observer: Any = None,
+    *,
+    _readiness: dict | None = None,
+    _production_truth: dict | None = None,
+) -> tuple[bool, str | None]:
+    production_conditions = _ProductionBuyGroups(observer, []) if _production_truth is not None else None
+    filter_cfg = _buy_ocr_filter_config(config, buy_cfg)
+    if not filter_cfg:
+        if _production_truth is not None:
+            _production_truth["ocr"] = True
+        return True, None
+
+    enabled = bool(filter_cfg.get("enabled", True))
+    logic = _logic(filter_cfg.get("conditions_logic", filter_cfg.get("logic", "AND")), "AND")
+    if not enabled:
+        if _production_truth is not None:
+            _production_truth["ocr"] = True
+        return True, _ocr_detail(
+            enabled=False,
+            logic=logic,
+            passed=True,
+            reason="disabled",
+            evaluation_index=evaluation_index,
+        )
+
+    conditions = filter_cfg.get("conditions")
+    if not isinstance(conditions, list) or not conditions:
+        if _readiness is not None:
+            _readiness["_validation_invalid_ocr"] = True
+        if _production_truth is not None:
+            _production_truth["ocr"] = None
+        return False, _ocr_detail(
+            enabled=True,
+            logic=logic,
+            passed=False,
+            reason="missing_conditions",
+            evaluation_index=evaluation_index,
+        )
+
+    condition_results = []
+    condition_details: list[str] = []
+    for condition_index, condition in enumerate(conditions):
+        if not isinstance(condition, dict):
+            if _readiness is not None:
+                _readiness["_validation_invalid_ocr"] = True
+            if _production_truth is not None:
+                _production_truth["ocr"] = None
+            return False, _ocr_detail(
+                enabled=True,
+                logic=logic,
+                passed=False,
+                reason="invalid_condition",
+                evaluation_index=evaluation_index,
+                condition_details=condition_details,
+            )
+        runtime_condition = dict(condition)
+        runtime_condition.setdefault("target", "OSC")
+        error = _ocr_condition_error(runtime_condition, series_map, evaluation_index)
+        if error is not None and not (_readiness is not None and error == "insufficient_data"):
+            if _readiness is not None:
+                _readiness["_validation_invalid_ocr"] = True
+            condition_details.append(
+                f"{runtime_condition.get('target')} {runtime_condition.get('operator')} reason={error}"
+            )
+            if _production_truth is not None:
+                _production_truth["ocr"] = None
+            return False, _ocr_detail(
+                enabled=True,
+                logic=logic,
+                passed=False,
+                reason=error,
+                evaluation_index=evaluation_index,
+                condition_details=condition_details,
+            )
+        result = evaluate_condition(
+            runtime_condition,
+            series_map,
+            evaluation_index,
+            production_conditions if production_conditions is not None else observer,
+            f"buy.filters.ocr.conditions[{condition_index}]",
+            readiness_safe=_readiness is not None,
+        )
+        condition_results.append(result)
+        condition_details.append(("PASS " if result.passed else "FAIL ") + result.detail)
+
+    if not condition_results:
+        if _readiness is not None:
+            _readiness["_validation_invalid_ocr"] = True
+        if _production_truth is not None:
+            _production_truth["ocr"] = None
+        return False, _ocr_detail(
+            enabled=True,
+            logic=logic,
+            passed=False,
+            reason="missing_conditions",
+            evaluation_index=evaluation_index,
+        )
+
+    passed = all(result.passed for result in condition_results) if logic == "AND" else any(
+        result.passed for result in condition_results
+    )
+    if _readiness is not None:
+        truth = condition_results_truth(condition_results, logic)
+        passed = truth is True
+        _readiness["ocr"] = truth is not None
+    if _production_truth is not None:
+        _production_truth["ocr"] = _buy_truth([production_conditions._condition_truth(condition, production_conditions.conditions.get(f"buy.filters.ocr.conditions[{index}]")) for index, condition in enumerate(conditions)], logic)
+    return passed, _ocr_detail(
+        enabled=True,
+        logic=logic,
+        passed=passed,
+        reason="matched" if passed else "not_matched",
+        evaluation_index=evaluation_index,
+        condition_details=condition_details,
+    )
+
+
+def _buy_stoch_rsi_filter_config(buy_cfg: dict[str, Any]) -> dict[str, Any]:
+    filters = buy_cfg.get("filters")
+    if not isinstance(filters, dict):
+        return {}
+    composite = filters.get("composite")
+    if not _is_buy_expression_mode(composite) or "E" not in composite["expression"]["identifiers"]:
+        return {}
+    value = filters.get("stoch_rsi")
+    # The expression owns activation; old checkbox-derived flags are ignored.
+    return {**(value if isinstance(value, dict) else {}), "enabled": True}
+
+
+def _buy_macd_filter_config(buy_cfg: dict[str, Any]) -> dict[str, Any]:
+    filters = buy_cfg.get("filters")
+    if not isinstance(filters, dict):
+        return {}
+    composite = filters.get("composite")
+    if not _is_buy_expression_mode(composite) or "F" not in composite["expression"]["identifiers"]:
+        return {}
+    value = filters.get("macd")
+    return {**(value if isinstance(value, dict) else {}), "enabled": True}
+
+
+def _evaluate_buy_macd_filter(
+    buy_cfg: dict[str, Any],
+    series_map: dict[str, list[float | None]],
+    evaluation_index: int,
+    *,
+    _readiness: dict | None = None,
+    _production_truth: dict | None = None,
+) -> tuple[bool, str | None]:
+    production_conditions = _ProductionBuyGroups(None, []) if _production_truth is not None else None
+    cfg = _buy_macd_filter_config(buy_cfg)
+    if not cfg or not cfg.get("enabled", False):
+        if _production_truth is not None:
+            _production_truth["macd"] = True
+        return True, None
+    conditions = cfg.get("conditions")
+    if not isinstance(conditions, list) or not conditions:
+        if _readiness is not None:
+            _readiness["_validation_invalid_macd"] = True
+        if _production_truth is not None:
+            _production_truth["macd"] = None
+        return False, "filter_type=MACD passed=False reason=missing_conditions"
+    passed = True
+    unavailable = False
+    for index, condition in enumerate(conditions):
+        if not isinstance(condition, dict):
+            if _readiness is not None:
+                _readiness["_validation_invalid_macd"] = True
+            if _production_truth is not None:
+                _production_truth["macd"] = None
+            return False, "filter_type=MACD passed=False reason=invalid_condition"
+        error = _ocr_condition_error(condition, series_map, evaluation_index)
+        if error is not None:
+            if error == "insufficient_data":
+                unavailable = True
+            passed = False
+            if error != "insufficient_data" or _readiness is None:
+                if _readiness is not None:
+                    _readiness["_validation_invalid_macd"] = True
+                if _production_truth is not None:
+                    _production_truth["macd"] = None
+                return False, f"filter_type=MACD passed=False reason={error}"
+            continue
+        result = evaluate_condition(
+            condition, series_map, evaluation_index,
+            production_conditions, f"buy.filters.macd.conditions[{index}]",
+            readiness_safe=_readiness is not None,
+        )
+        passed = passed and result.passed
+    if _readiness is not None:
+        _readiness["macd"] = not unavailable
+    if _production_truth is not None:
+        _production_truth["macd"] = _buy_truth([production_conditions._condition_truth(condition, production_conditions.conditions.get(f"buy.filters.macd.conditions[{index}]")) for index, condition in enumerate(conditions)])
+    return passed, (
+        f"filter_type=MACD enabled=True passed={passed} "
+        f"reason={'insufficient_data' if unavailable else ('matched' if passed else 'not_matched')} "
+        f"evaluation_index={evaluation_index}"
+    )
+
+
+def _stoch_rsi_d_series(closes: list[float | None], history_window: int) -> list[float | None]:
+    """Fixed Wilder14 / stochastic14 / SMA3 / SMA3, on each causal window."""
+    def calculate(values):
+        rsi_values = rsi(values, 14)
+        raw = [None] * len(values)
+        for index in range(27, len(values)):
+            window = rsi_values[index - 13:index + 1]
+            if any(value is None or not isfinite(value) for value in window):
+                continue
+            low, high = min(window), max(window)
+            # Wilder rounding noise must not turn a flat RSI into an oversold value.
+            if high - low > 1e-12:
+                raw[index] = 100.0 * (window[-1] - low) / (high - low)
+            else:
+                raw[index] = 50.0
+        # Require consecutive observations; never smooth across unavailable data.
+        for _ in range(2):
+            smoothed = [None] * len(values)
+            for index in range(2, len(values)):
+                window = raw[index - 2:index + 1]
+                if all(value is not None for value in window):
+                    smoothed[index] = min(100.0, max(0.0, sum(window) / 3))
+            raw = smoothed
+        return raw
+
+    history_window = max(int(history_window), 32)
+    result = calculate(closes[:history_window])
+    for index in range(history_window, len(closes)):
+        result.append(calculate(closes[index - history_window + 1:index + 1])[-1])
+    return result
+
+
+def _evaluate_buy_stoch_rsi_filter(buy_cfg, series_map, evaluation_index, *, _readiness=None, _production_truth=None):
+    cfg = _buy_stoch_rsi_filter_config(buy_cfg)
+    if not cfg or not bool(cfg.get("enabled", False)):
+        if _production_truth is not None:
+            _production_truth["stoch_rsi"] = True
+        return True, None
+    threshold = _safe_float(cfg.get("threshold", 20))
+    value = _series_value_at(series_map, "STOCH_RSI_D", evaluation_index)
+    available = value is not None and isfinite(value) and 0 <= value <= 100
+    if _readiness is not None and (threshold is None or not isfinite(threshold) or not 0 <= threshold <= 100):
+        _readiness["_validation_invalid_stoch_rsi"] = True
+    if not available and _readiness is not None:
+        _readiness["stoch_rsi"] = False
+    operator = str(cfg.get("operator", "<=")).strip()
+    if operator not in {"<=", ">="}:
+        operator = "<="
+    passed = bool(
+        available and threshold is not None and isfinite(threshold)
+        and 0 <= threshold <= 100
+        and (value >= threshold if operator == ">=" else value <= threshold)
+    )
+    if _production_truth is not None:
+        _production_truth["stoch_rsi"] = (bool(passed) if available and threshold is not None and isfinite(threshold) and 0 <= threshold <= 100 else None)
+    return passed, (
+        f"filter_type=STOCH_RSI_D enabled=True settings=14,14,3,3 operator={operator} "
+        f"threshold={threshold} evaluated_value={value} passed={passed} "
+        f"reason={'evaluated' if available else 'insufficient_data'} evaluation_index={evaluation_index}"
+    )
+
+
+def _buy_target_percent_filter_config(buy_cfg: dict[str, Any]) -> dict[str, Any]:
+    filters = buy_cfg.get("filters")
+    if not isinstance(filters, dict):
+        return {}
+    composite = filters.get("composite")
+    if not _is_buy_expression_mode(composite) or "G" not in composite["expression"]["identifiers"]:
+        return {}
+    value = filters.get("target_percent")
+    return {**(value if isinstance(value, dict) else {}), "enabled": True}
+
+
+def _evaluate_buy_target_percent_filter(buy_cfg, series_map, evaluation_index, observer=None, *, _production_truth=None):
+    cfg = _buy_target_percent_filter_config(buy_cfg)
+    result = {"passed": True, "detail": None, "configured": bool(cfg),
+              "enabled": bool(cfg), "unavailable": False}
+    if not cfg:
+        return result
+    average_series = series_map.get("_BUY_TARGET_PERCENT_AVG_PRICE", series_map.get("AVG_PRICE"))
+    average = _safe_float(_series_value_at({"AVG_PRICE": average_series}, "AVG_PRICE", evaluation_index))
+    if average is None or not isfinite(average) or average <= 0:
+        result.update(passed=False, unavailable=True, inapplicable=True,
+                      detail="filter_type=TARGET_PERCENT enabled=True passed=False reason=no_valid_average")
+        return result
+    series_map = {**series_map, "AVG_PRICE": average_series}
+    conditions = cfg.get("conditions")
+    if not isinstance(conditions, list) or len(conditions) != 1 or not isinstance(conditions[0], dict):
+        result.update(passed=False, unavailable=True, detail="filter_type=TARGET_PERCENT enabled=True passed=False reason=missing_conditions")
+        return result
+    condition = conditions[0]
+    if (condition.get("operator") != "PERCENT_GAP"
+            or {condition.get("target"), condition.get("compare_target")} != {"CURRENT_PRICE", "AVG_PRICE"}):
+        result.update(passed=False, unavailable=True, detail="filter_type=TARGET_PERCENT enabled=True passed=False reason=invalid_condition")
+        return result
+    production_conditions = _ProductionBuyGroups(observer, []) if _production_truth is not None else None
+    evaluated = evaluate_condition(
+        condition, series_map, evaluation_index, production_conditions if production_conditions is not None else observer,
+        "buy.filters.target_percent.conditions[0]",
+    )
+    if _production_truth is not None:
+        _production_truth["target_percent"] = production_conditions._condition_truth(condition, production_conditions.conditions.get("buy.filters.target_percent.conditions[0]"))
+    # Preserve unknown truth even on the production readiness_safe=False path.
+    result.update(passed=evaluated.passed, unavailable=not evaluated.available)
+    reason = "insufficient_data" if not evaluated.available else ("matched" if evaluated.passed else "not_matched")
+    result["detail"] = (
+        f"filter_type=TARGET_PERCENT enabled=True passed={evaluated.passed} reason={reason} "
+        f"current_value={_series_value_at(series_map, condition['target'], evaluation_index)} "
+        f"basis_value={_series_value_at(series_map, condition['compare_target'], evaluation_index)}"
+    )
+    return result
+
+
+BUY_FILTER_ORDER = ("rsi", "moving_average", "price_compare", "bollinger", "ocr", "stoch_rsi", "macd", "target_percent")
+
+
+def _buy_composite_filter_config(config: dict[str, Any], buy_cfg: dict[str, Any]) -> dict[str, Any]:
+    filters = buy_cfg.get("filters")
+    if isinstance(filters, dict) and "composite" in filters:
+        composite = filters.get("composite")
+        if isinstance(composite, dict):
+            return composite
+        return {"enabled": True, "_invalid_config": True}
+    return {}
+
+
+def _buy_filter_config_map(config: dict[str, Any], buy_cfg: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    return {
+        "rsi": _buy_rsi_filter_config(config, buy_cfg),
+        "moving_average": _buy_moving_average_filter_config(config, buy_cfg),
+        "price_compare": _buy_price_compare_filter_config(config, buy_cfg),
+        "bollinger": _buy_bollinger_filter_config(config, buy_cfg),
+        "ocr": _buy_ocr_filter_config(config, buy_cfg),
+        "stoch_rsi": _buy_stoch_rsi_filter_config(buy_cfg),
+        "macd": _buy_macd_filter_config(buy_cfg),
+        "target_percent": _buy_target_percent_filter_config(buy_cfg),
+    }
+
+
+def _composite_logic(value: Any) -> str | None:
+    text = str(value or "").strip().upper()
+    return text if text in {"AND", "OR"} else None
+
+
+def _composite_detail(
+    *,
+    enabled: bool,
+    logic: Any,
+    passed: bool,
+    reason: str,
+    referenced_filters: list[str],
+    unreferenced_required_filters: list[str],
+    group_results: list[str],
+) -> str:
+    return (
+        "filter_type=COMPOSITE "
+        f"enabled={enabled} "
+        f"logic={logic} "
+        f"passed={passed} "
+        f"reason={reason} "
+        f"referenced_filters={','.join(referenced_filters)} "
+        f"unreferenced_required_filters={','.join(unreferenced_required_filters)} "
+        f"group_results={';'.join(group_results)}"
+    )
+
+
+def _omit_buy_target_percent(expression_ast):
+    """Prune G from a validated evaluation AST, collapsing either missing operand."""
+    if str(expression_ast["type"]).strip().lower() == "identifier":
+        return None if str(expression_ast["name"]).strip().upper() == "G" else expression_ast
+    left = _omit_buy_target_percent(expression_ast["left"])
+    right = _omit_buy_target_percent(expression_ast["right"])
+    if left is None:
+        return right
+    if right is None:
+        return left
+    return {**expression_ast, "left": left, "right": right}
+
+
+def _buy_truth(values, logic="AND"):
+    values = list(values)
+    if not values:
+        return None
+    if logic == "AND":
+        return False if False in values else (True if all(v is True for v in values) else None)
+    return True if True in values else (False if all(v is False for v in values) else None)
+
+
+def _observe_validation_buy(callback, candles, signal_index, truth, status=None):
+    if not callable(callback):
+        return
+    source = signal_index if type(signal_index) is int and 0 <= signal_index < len(candles) else None
+    callback(dict(
+        evaluation_index=len(candles) - 1,
+        evaluation_time=str(candles[-1].get("time") or "") if candles else "",
+        signal_index=source,
+        signal_time=str(candles[source].get("time") or "") if source is not None else None,
+        status=status or ("EVALUATED" if type(truth) is bool else "UNAVAILABLE"),
+        buy_result=truth if type(truth) is bool else None,
+    ))
+
+
+def _observe_production_buy(callback, candles, signal_index, truth):
+    try:
+        _observe_validation_buy(callback, candles, signal_index, truth)
+    except Exception:
+        pass  # An optional observation cannot change the existing signal result.
+
+
+class _ProductionBuyGroups:
+    """Read the actual condition operands; forward the original observer unchanged."""
+    def __init__(self, observer, groups):
+        self.observer, self.groups, self.conditions = observer, groups, {}
+        self.group_values = []
+
+    def observe_condition(self, event):
+        self.conditions[event.get("path")] = event
+        _notify_decision_observer(self.observer, "observe_condition", event)
+
+    def observe_group(self, event):
+        _notify_decision_observer(self.observer, "observe_group", event)
+        if event.get("enabled") is False:
+            return
+        try:
+            index = int(event["path"].split("[")[-1].split("]")[0])
+            group = self.groups[index]
+            values = {}
+            for offset, condition in enumerate(group.get("conditions") or []):
+                key = str(condition.get("expression_id") or f"C{offset}").strip().upper() if isinstance(condition, dict) else f"C{offset}"
+                if key in values:
+                    self.group_values.append(None)
+                    return
+                actual = self.conditions.get(f'{event["path"]}.conditions[{offset}]')
+                values[key] = self._condition_truth(condition, actual)
+            expression = event.get("condition_expression")
+            if expression is not None:
+                observed = evaluate_condition_expression(expression, values, current_identity="__CURRENT__")
+                truth = observed.get("passed") if observed.get("ok") and not observed.get("unavailable") else None
+            else:
+                logic = group.get("conditions_logic", group.get("logic", "AND"))
+                truth = _buy_truth(values.values(), logic) if logic in {"AND", "OR"} else None
+            self.group_values.append(truth)
+        except (KeyError, ValueError, TypeError, IndexError):
+            self.group_values.append(None)
+
+    @staticmethod
+    def _condition_truth(condition, actual):
+        if not isinstance(condition, dict) or not isinstance(actual, dict):
+            return None
+        if condition.get("enabled", True) is False:
+            return True
+        operator = actual.get("operator")
+        comparisons = {">", ">=", "<", "<=", "=", "==", "GT", "GTE", "LT", "LTE", "EQ", "ABOVE", "BELOW"}
+        supported = comparisons | {"TURN_UP", "TURN_DOWN", "TREND_UP", "TREND_DOWN", "CROSS_UP", "CROSS_DOWN", "ZERO_CROSS_UP", "ZERO_CROSS_DOWN", "PERCENT_GAP"}
+        if operator not in supported:
+            return None
+        snapshots = actual.get("indicator_snapshots") or []
+        fields = ["current"]
+        if operator in {"TURN_UP", "TURN_DOWN"}:
+            fields += ["previous", "previous2"]
+        elif operator in {"TREND_UP", "TREND_DOWN", "CROSS_UP", "CROSS_DOWN", "ZERO_CROSS_UP", "ZERO_CROSS_DOWN"}:
+            fields += ["previous"]
+        if not snapshots or any(type(row.get(field)) not in (int, float) or not isfinite(row[field]) for row in snapshots for field in fields):
+            return None
+        if operator in comparisons:
+            value = (actual.get("right_operand") or {}).get("value")
+            if type(value) not in (int, float) or not isfinite(value):
+                return None
+        if operator == "PERCENT_GAP":
+            percent = _safe_float(condition.get("value"))
+            direction, mode = condition.get("direction"), condition.get("compare_mode")
+            if (percent is None or not isfinite(percent) or percent < 0
+                    or direction not in {"UP", "DOWN", "BOTH"}
+                    or mode not in ({"WITHIN", "OUTSIDE"} if direction == "BOTH" else {"GTE", "LTE"})
+                    or (actual.get("right_operand") or {}).get("value", 0) <= 0):
+                return None
+        return actual.get("final_result") if type(actual.get("final_result")) is bool else None
+
+    def truth(self):
+        return _buy_truth(self.group_values, "OR")
+
+
+def _validation_filter_truth(name, passed, readiness):
+    if readiness is None or readiness.get(name) is False or readiness.get("_validation_invalid_" + name):
+        return None
+    return bool(passed)
+
+
+def _production_composite_truth(composite, results, truth):
+    """Aggregate the operands recorded by this invocation, including unknowns."""
+    if truth is None:
+        return None
+    expression = composite.get("expression")
+    if isinstance(expression, dict):
+        identifiers, mapping = expression.get("identifiers"), expression.get("identifier_map")
+        if not isinstance(identifiers, list) or not isinstance(mapping, dict):
+            return None
+        values = {key: truth.get(mapping.get(key)) for key in identifiers}
+        observed = evaluate_condition_expression(expression.get("ast"), values, current_identity="__CURRENT__")
+        return observed.get("passed") if observed.get("ok") and not observed.get("unavailable") else None
+    groups = composite.get("groups")
+    if not isinstance(groups, list) or not groups or _composite_logic(composite.get("logic", "AND")) is None:
+        return None
+    seen, values = set(), []
+    for group in groups:
+        if not isinstance(group, dict):
+            return None
+        if group.get("enabled", True) is False:
+            continue
+        names = group.get("filters")
+        logic = _composite_logic(group.get("logic", "AND"))
+        if not logic or not isinstance(names, list) or not names or len(set(names)) != len(names):
+            return None
+        active = []
+        for name in names:
+            result = results.get(name)
+            if not isinstance(result, dict) or not result.get("configured"):
+                return None
+            seen.add(name)
+            if result.get("enabled", True):
+                active.append(truth.get(name))
+        values.append(_buy_truth(active, logic))
+    return _buy_truth([_buy_truth(values, composite.get("logic", "AND")),
+        *(truth.get(name) for name, result in results.items()
+          if name not in seen and result.get("configured") and result.get("enabled", True))])
+
+
+def _evaluate_buy_composite_filter(
+    composite_cfg: dict[str, Any],
+    filter_results: dict[str, dict[str, Any]],
+    *,
+    _readiness: dict | None = None,
+    _validation_truth: dict | None = None,
+) -> tuple[bool, str | None]:
+    if _validation_truth is not None:
+        _validation_truth["result"] = None
+    if not composite_cfg or not bool(composite_cfg.get("enabled", False)):
+        return True, None
+
+    if composite_cfg.get("_invalid_config"):
+        return False, _composite_detail(
+            enabled=True,
+            logic=composite_cfg.get("logic"),
+            passed=False,
+            reason="invalid_config",
+            referenced_filters=[],
+            unreferenced_required_filters=[],
+            group_results=[],
+        )
+
+    expression = composite_cfg.get("expression")
+    if isinstance(expression, dict):
+        identifier_map = expression.get("identifier_map")
+        expression_ast = expression.get("ast")
+        identifiers = expression.get("identifiers")
+        if not isinstance(identifier_map, dict) or not isinstance(identifiers, list):
+            return False, _composite_detail(
+                enabled=True,
+                logic="EXPRESSION",
+                passed=False,
+                reason="invalid_expression_contract",
+                referenced_filters=[],
+                unreferenced_required_filters=[],
+                group_results=[],
+            )
+        values: dict[str, bool] = {}
+        referenced_filters: list[str] = []
+        omit_g = False
+        for raw_identifier in identifiers:
+            identifier = str(raw_identifier or "").strip().upper()
+            filter_name = str(identifier_map.get(identifier) or "").strip().lower()
+            result = filter_results.get(filter_name)
+            if (
+                not filter_name
+                or not isinstance(result, dict)
+                or not result.get("configured", False)
+                or not result.get("enabled", False)
+            ):
+                return False, _composite_detail(
+                    enabled=True,
+                    logic="EXPRESSION",
+                    passed=False,
+                    reason=f"expression_filter_unavailable:{identifier}",
+                    referenced_filters=referenced_filters,
+                    unreferenced_required_filters=[],
+                    group_results=[],
+                )
+            values[identifier] = (None if result.get("unavailable")
+                                  or (_readiness is not None and _readiness.get(filter_name) is False)
+                                  else bool(result.get("passed", False)))
+            if identifier == "G" and filter_name == "target_percent" and result.get("inapplicable"):
+                omit_g = True
+            if filter_name not in referenced_filters:
+                referenced_filters.append(filter_name)
+        evaluated = evaluate_condition_expression(
+            expression_ast,
+            values,
+        )
+        if evaluated.get("ok") and omit_g:
+            expression_ast = _omit_buy_target_percent(expression_ast)
+            evaluated = (evaluate_condition_expression(expression_ast, values)
+                         if expression_ast is not None else {"ok": True, "passed": False})
+        if _validation_truth is not None and evaluated.get("ok"):
+            observed_values = {}
+            for key in values:
+                name = str(identifier_map.get(key) or "")
+                result = filter_results[name]
+                observed_values[key] = (None if name == "target_percent" and result.get("unavailable")
+                                       else _validation_filter_truth(name, result["passed"], _readiness))
+            observed = (evaluate_condition_expression(expression_ast, observed_values, current_identity="__CURRENT__")
+                        if expression_ast is not None else {"ok": False})
+            _validation_truth["result"] = (observed["passed"] if observed.get("ok")
+                                           and not observed.get("unavailable") else None)
+        passed = bool(evaluated.get("passed")) if evaluated.get("ok") else False
+        return passed, _composite_detail(
+            enabled=True,
+            logic="EXPRESSION",
+            passed=passed,
+            reason="expression_evaluated" if evaluated.get("ok") else str(evaluated.get("reason")),
+            referenced_filters=referenced_filters,
+            unreferenced_required_filters=[],
+            group_results=[f"{key}:{'PASS' if value else 'FAIL'}" for key, value in values.items()],
+        )
+
+    top_logic = _composite_logic(composite_cfg.get("logic", "AND"))
+    if top_logic is None:
+        return False, _composite_detail(
+            enabled=True,
+            logic=composite_cfg.get("logic"),
+            passed=False,
+            reason="invalid_logic",
+            referenced_filters=[],
+            unreferenced_required_filters=[],
+            group_results=[],
+        )
+
+    include_policy = str(composite_cfg.get("include_unreferenced_active_filters", "AND_REQUIRED") or "").strip().upper()
+    if include_policy != "AND_REQUIRED":
+        return False, _composite_detail(
+            enabled=True,
+            logic=top_logic,
+            passed=False,
+            reason="unsupported_unreferenced_policy",
+            referenced_filters=[],
+            unreferenced_required_filters=[],
+            group_results=[],
+        )
+
+    groups = composite_cfg.get("groups")
+    if not isinstance(groups, list) or not groups:
+        return False, _composite_detail(
+            enabled=True,
+            logic=top_logic,
+            passed=False,
+            reason="missing_groups",
+            referenced_filters=[],
+            unreferenced_required_filters=[],
+            group_results=[],
+        )
+
+    active_group_seen = False
+    referenced_filters: list[str] = []
+    group_passes: list[bool] = []
+    group_results: list[str] = []
+    observed_groups = []
+
+    for group_index, group in enumerate(groups):
+        if not isinstance(group, dict):
+            return False, _composite_detail(
+                enabled=True,
+                logic=top_logic,
+                passed=False,
+                reason="invalid_group",
+                referenced_filters=referenced_filters,
+                unreferenced_required_filters=[],
+                group_results=group_results,
+            )
+        if not bool(group.get("enabled", True)):
+            continue
+        active_group_seen = True
+        group_logic = _composite_logic(group.get("logic", "AND"))
+        if group_logic is None:
+            return False, _composite_detail(
+                enabled=True,
+                logic=top_logic,
+                passed=False,
+                reason="invalid_group_logic",
+                referenced_filters=referenced_filters,
+                unreferenced_required_filters=[],
+                group_results=group_results,
+            )
+        filters = group.get("filters")
+        if not isinstance(filters, list) or not filters:
+            return False, _composite_detail(
+                enabled=True,
+                logic=top_logic,
+                passed=False,
+                reason="missing_group_filters",
+                referenced_filters=referenced_filters,
+                unreferenced_required_filters=[],
+                group_results=group_results,
+            )
+
+        seen_in_group: set[str] = set()
+        active_filter_passes: list[bool] = []
+        observed_filters = []
+        group_tokens: list[str] = []
+        for raw_name in filters:
+            name = str(raw_name or "").strip().lower()
+            if name == "composite":
+                return False, _composite_detail(
+                    enabled=True,
+                    logic=top_logic,
+                    passed=False,
+                    reason="self_reference",
+                    referenced_filters=referenced_filters,
+                    unreferenced_required_filters=[],
+                    group_results=group_results,
+                )
+            if name not in BUY_FILTER_ORDER:
+                return False, _composite_detail(
+                    enabled=True,
+                    logic=top_logic,
+                    passed=False,
+                    reason="unknown_filter",
+                    referenced_filters=referenced_filters,
+                    unreferenced_required_filters=[],
+                    group_results=group_results,
+                )
+            if name in seen_in_group:
+                return False, _composite_detail(
+                    enabled=True,
+                    logic=top_logic,
+                    passed=False,
+                    reason="duplicate_filter_in_group",
+                    referenced_filters=referenced_filters,
+                    unreferenced_required_filters=[],
+                    group_results=group_results,
+                )
+            seen_in_group.add(name)
+            if name not in referenced_filters:
+                referenced_filters.append(name)
+            result = filter_results.get(name)
+            if not isinstance(result, dict):
+                return False, _composite_detail(
+                    enabled=True,
+                    logic=top_logic,
+                    passed=False,
+                    reason="missing_filter_result",
+                    referenced_filters=referenced_filters,
+                    unreferenced_required_filters=[],
+                    group_results=group_results,
+                )
+            if not result.get("configured", False):
+                return False, _composite_detail(
+                    enabled=True,
+                    logic=top_logic,
+                    passed=False,
+                    reason="missing_filter_result",
+                    referenced_filters=referenced_filters,
+                    unreferenced_required_filters=[],
+                    group_results=group_results,
+                )
+            if not result.get("enabled", True):
+                group_tokens.append(f"{name}:disabled_ignored")
+                continue
+            passed = bool(result.get("passed", False))
+            active_filter_passes.append(passed)
+            observed_filters.append(_validation_filter_truth(name, passed, _readiness))
+            group_tokens.append(f"{name}:{'PASS' if passed else 'FAIL'}")
+
+        if not active_filter_passes:
+            return False, _composite_detail(
+                enabled=True,
+                logic=top_logic,
+                passed=False,
+                reason="group_has_no_active_filters",
+                referenced_filters=referenced_filters,
+                unreferenced_required_filters=[],
+                group_results=group_results + [f"group{group_index}:BLOCK:{','.join(group_tokens)}"],
+            )
+
+        group_passed = all(active_filter_passes) if group_logic == "AND" else any(active_filter_passes)
+        group_passes.append(group_passed)
+        observed_groups.append(_buy_truth(observed_filters, group_logic))
+        group_results.append(f"group{group_index}:{group_logic}:{'PASS' if group_passed else 'FAIL'}:{','.join(group_tokens)}")
+
+    if not active_group_seen:
+        return False, _composite_detail(
+            enabled=True,
+            logic=top_logic,
+            passed=False,
+            reason="all_groups_disabled",
+            referenced_filters=referenced_filters,
+            unreferenced_required_filters=[],
+            group_results=group_results,
+        )
+
+    composite_passed = all(group_passes) if top_logic == "AND" else any(group_passes)
+    unreferenced_required = [
+        name
+        for name in BUY_FILTER_ORDER
+        if name not in referenced_filters
+        and isinstance(filter_results.get(name), dict)
+        and filter_results[name].get("configured", False)
+        and filter_results[name].get("enabled", True)
+    ]
+    unreferenced_passed = all(bool(filter_results[name].get("passed", False)) for name in unreferenced_required)
+    passed = composite_passed and unreferenced_passed
+    if _validation_truth is not None:
+        _validation_truth["result"] = _buy_truth([
+            _buy_truth(observed_groups, top_logic),
+            *(_validation_filter_truth(name, filter_results[name].get("passed"), _readiness)
+              for name in unreferenced_required),
+        ])
+    if passed:
+        reason = "matched"
+    elif not composite_passed:
+        reason = "not_matched"
+    else:
+        reason = "unreferenced_required_failed"
+
+    return passed, _composite_detail(
+        enabled=True,
+        logic=top_logic,
+        passed=passed,
+        reason=reason,
+        referenced_filters=referenced_filters,
+        unreferenced_required_filters=unreferenced_required,
+        group_results=group_results,
+    )
+
+
+def _is_buy_expression_mode(composite_cfg: Any) -> bool:
+    if not isinstance(composite_cfg, dict) or not bool(composite_cfg.get("enabled", False)):
+        return False
+    expression = composite_cfg.get("expression")
+    if not isinstance(expression, dict):
+        return False
+    expression_ast = expression.get("ast")
+    identifiers = expression.get("identifiers")
+    identifier_map = expression.get("identifier_map")
+    if (
+        not isinstance(expression_ast, dict)
+        or not isinstance(identifiers, list)
+        or not identifiers
+        or not isinstance(identifier_map, dict)
+    ):
+        return False
+    values: dict[str, bool] = {}
+    allowed_filters = {"ocr", "bollinger", "moving_average", "rsi", "stoch_rsi", "macd", "target_percent"}
+    for raw_identifier in identifiers:
+        identifier = str(raw_identifier or "").strip().upper()
+        filter_name = str(identifier_map.get(identifier) or "").strip().lower()
+        if not identifier or filter_name not in allowed_filters:
+            return False
+        values[identifier] = True
+    return bool(evaluate_condition_expression(expression_ast, values).get("ok"))
+
+
+def _evaluate_buy_expression_mode(
+    cfg: dict[str, Any],
+    buy_cfg: dict[str, Any],
+    composite_cfg: dict[str, Any],
+    candles: list[dict[str, Any]],
+    series_map: dict[str, list[float | None]],
+    buy_index: int,
+    buy_delay: int,
+    observer: Any,
+    *,
+    readiness_safe: bool = False,
+    validation_buy_observer=None,
+    production_buy_observer=None,
+) -> RoutineSignal:
+    readiness = {} if readiness_safe else None
+    production_truth = {} if callable(production_buy_observer) else None
+    filter_cfgs = _buy_filter_config_map(cfg, buy_cfg)
+    filter_results: dict[str, dict[str, Any]] = {}
+    details: list[str] = []
+
+    rsi_passed, rsi_detail = _evaluate_buy_rsi_filter(
+        cfg, buy_cfg, candles, buy_index, series_map, _readiness=readiness, _production_truth=production_truth
+    )
+    if rsi_detail:
+        details.append(rsi_detail)
+    filter_results["rsi"] = {
+        "passed": rsi_passed,
+        "detail": rsi_detail,
+        "configured": bool(filter_cfgs["rsi"]),
+        "enabled": bool(filter_cfgs["rsi"].get("enabled", True)) if filter_cfgs["rsi"] else False,
+    }
+
+    ma_passed, ma_detail = _evaluate_buy_moving_average_filter(
+        cfg, buy_cfg, series_map, buy_index, observer, _readiness=readiness, _production_truth=production_truth
+    )
+    if ma_detail:
+        details.append(ma_detail)
+    filter_results["moving_average"] = {
+        "passed": ma_passed,
+        "detail": ma_detail,
+        "configured": bool(filter_cfgs["moving_average"]),
+        "enabled": bool(filter_cfgs["moving_average"].get("enabled", True)) if filter_cfgs["moving_average"] else False,
+    }
+
+    bollinger_passed, bollinger_detail = _evaluate_buy_bollinger_filter(
+        cfg, buy_cfg, series_map, buy_index, _readiness=readiness, _production_truth=production_truth
+    )
+    if bollinger_detail:
+        details.append(bollinger_detail)
+    filter_results["bollinger"] = {
+        "passed": bollinger_passed,
+        "detail": bollinger_detail,
+        "configured": bool(filter_cfgs["bollinger"]),
+        "enabled": bool(filter_cfgs["bollinger"].get("enabled", True)) if filter_cfgs["bollinger"] else False,
+    }
+
+    ocr_passed, ocr_detail = _evaluate_buy_ocr_filter(
+        cfg, buy_cfg, series_map, buy_index, observer, _readiness=readiness, _production_truth=production_truth
+    )
+    if ocr_detail:
+        details.append(ocr_detail)
+    filter_results["ocr"] = {
+        "passed": ocr_passed,
+        "detail": ocr_detail,
+        "configured": bool(filter_cfgs["ocr"]),
+        "enabled": bool(filter_cfgs["ocr"].get("enabled", True)) if filter_cfgs["ocr"] else False,
+    }
+
+    stoch_passed, stoch_detail = _evaluate_buy_stoch_rsi_filter(
+        buy_cfg, series_map, len(candles) - 1, _readiness=readiness, _production_truth=production_truth
+    )
+    if stoch_detail:
+        details.append(stoch_detail)
+    stoch_cfg = filter_cfgs["stoch_rsi"]
+    filter_results["stoch_rsi"] = {
+        "passed": stoch_passed, "detail": stoch_detail,
+        "configured": bool(stoch_cfg), "enabled": bool(stoch_cfg.get("enabled", False)),
+        "unavailable": bool(stoch_detail and "reason=insufficient_data" in stoch_detail),
+    }
+
+    macd_passed, macd_detail = _evaluate_buy_macd_filter(
+        buy_cfg, series_map, len(candles) - 1, _readiness=readiness, _production_truth=production_truth,
+    )
+    if macd_detail:
+        details.append(macd_detail)
+    macd_cfg = filter_cfgs["macd"]
+    filter_results["macd"] = {
+        "passed": macd_passed, "detail": macd_detail,
+        "configured": bool(macd_cfg), "enabled": bool(macd_cfg.get("enabled", False)),
+        "unavailable": bool(macd_detail and "reason=insufficient_data" in macd_detail),
+    }
+
+    target_percent_result = _evaluate_buy_target_percent_filter(buy_cfg, series_map, buy_index, observer, _production_truth=production_truth)
+    if production_truth is not None:
+        production_truth.setdefault("target_percent", None if target_percent_result.get("unavailable")
+                                    else bool(target_percent_result["passed"]))
+    filter_results["target_percent"] = target_percent_result
+    if target_percent_result["detail"]:
+        details.append(target_percent_result["detail"])
+
+    condition_truth = {} if callable(validation_buy_observer) else None
+    composite_passed, composite_detail = _evaluate_buy_composite_filter(
+        composite_cfg,
+        filter_results,
+        _readiness=readiness,
+        _validation_truth=condition_truth,
+    )
+    _observe_validation_buy(validation_buy_observer, candles, buy_index,
+                            condition_truth.get("result") if condition_truth is not None else None)
+    _observe_production_buy(production_buy_observer, candles, buy_index,
+        _production_composite_truth(composite_cfg, filter_results, production_truth))
+    if composite_detail:
+        details.append(composite_detail)
+    if not composite_passed:
+        return RoutineSignal(
+            None,
+            "BUY composite filter blocked",
+            [],
+            details,
+            buy_index,
+            buy_delay,
+        )
+    return RoutineSignal(
+        "BUY",
+        "매수조건 충족",
+        [],
+        details,
+        buy_index,
+        buy_delay,
+    )
+
