+    if operator in {"<=", "LTE", "LE", "BELOW_OR_EQUAL"} or raw_value == "이하":
+        return "<="
+    if operator in {">=", "GTE", "GE", "ABOVE_OR_EQUAL"} or raw_value == "이상":
