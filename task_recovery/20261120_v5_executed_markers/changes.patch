+def test_v5_executed_arrow_label_cache_republication_and_reprojection(case):
+    from tests.test_v5_lot_limit_execution import candles as price_candles
+    rows = price_candles([100, 100, 100, 100, 90, 90, 110])
+    rows[3]["display_only_special"] = rows[5]["display_only_special"] = True
+    window = _stop_display_window(case, rows, (("BUY", 2), ("BUY", 4), ("SELL", 6)), {}, bounds=(2, 6))
+    canvas = window.canvas
+    canvas.resize(800, 400)
+    records = window._chart_marker_records()
+    singles = [{k: v for k, v in r.items() if k != "ordinary_execution_fills"} for r in records]
+    canvas.set_marker_records(singles)
+    scale = canvas.price_scale()
+    canvas.completed_cycle_average_label_records(scale)
+    single_key = canvas._completed_cycle_label_cache_key
+    single_blockers = canvas._completed_cycle_label_blockers(scale)
+    canvas._static_chart_cache = object()
+    canvas._static_chart_cache_key = object()
+    canvas._pinned_marker_key = (2, "BUY")
+    canvas.set_marker_records(records)
+    assert canvas._static_chart_cache is None and canvas._static_chart_cache_key is None
+    assert canvas._pinned_marker_key == (2, "BUY")
+    canvas.completed_cycle_average_label_records(scale)
+    assert canvas._completed_cycle_label_cache_key != single_key
+    double_blockers = canvas._completed_cycle_label_blockers(scale)
+    for i in range(len(single_blockers)):
+        assert double_blockers[i].contains(single_blockers[i])
+    assert any(b.height() == a.height() + 13 for a, b in zip(single_blockers, double_blockers))
+    cycles = deepcopy(window.completed_cycles)
+    with patch.object(window_module.QTimer, "singleShot"):
+        window._on_validation_range_liquidation_changed()
+        assert canvas.marker_records() == records
+        window._select_virtual_fill_price_basis("OHLC4")
+        assert {(r["evaluation_index"], r["side"]) for r in canvas.marker_records()
+                if r.get("ordinary_execution_fills")} == {(2, "BUY"), (4, "BUY"), (6, "SELL")}
+    assert window.completed_cycles == cycles
+    window._refresh_marking_projection()
+    assert all(r.get("ordinary_execution_fills") for r in canvas.marker_records())
+    assert all(type(c.cycle_number) is int for c in window.completed_cycles)
+    window._set_validation_range(None, None)
+    assert not any(r.get("ordinary_execution_fills") for r in canvas.marker_records())
+    window._set_validation_range(2, 6)
+    window._range_replay_entries_available = True
+    window._range_replay_entries = _stop_display_entries(rows, ("BUY", 2), ("BUY", 4), ("SELL", 6))
+    window._range_replay_settings_snapshot = window_module.ValidationSettingsSnapshot({"validation_execution": {}})
+    window._refresh_marking_projection()
+    assert {(r["evaluation_index"], r["side"]) for r in canvas.marker_records()
+            if r.get("ordinary_execution_fills")} == {(2, "BUY"), (4, "BUY"), (6, "SELL")}
+
