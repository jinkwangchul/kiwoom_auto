+@pytest.mark.parametrize("lot_enabled", [False, True])
+def test_v5_executed_arrow_projection_uses_positive_ordinary_fills(case, lot_enabled):
+    from dataclasses import replace
+    from tests.test_v5_lot_limit_execution import ON, candles as price_candles
+    rows = price_candles([100, 100, 100, 100, 90, 90, 100, 80, 80])
+    rows[3]["display_only_special"] = rows[5]["display_only_special"] = True
+    signals = (("BUY", 2), ("BUY", 4), ("SELL", 6), ("BUY", 7), ("SELL", 8))
+    window = _stop_display_window(case, rows, signals,
+                                  {**ON, "lot_limit_enabled": lot_enabled}, bounds=(2, 8))
+    financials = deepcopy(window.completed_cycles)
+    records = window._chart_marker_records()
+    ordinary = [r for r in records if r.get("ordinary_execution_fills")]
+    signals_to_keys = [(index, side) for side, index in signals]
+    assert {(r["evaluation_index"], r["side"]) for r in ordinary} == set(signals_to_keys)
+    assert len(ordinary) == len(signals_to_keys)
+    for record in ordinary:
+        for fill in record["ordinary_execution_fills"]:
+            assert (fill.evaluation_index, fill.side, fill.evaluation_time) == (
+                record["evaluation_index"], record["side"], rows[record["evaluation_index"]]["time"])
+            assert fill.quantity > 0
+            assert fill.reason not in {"LOT_LIMIT_TARGET", "STOP_LOSS", "RANGE_END_LIQUIDATION"}
+    assert [r["ordinary_execution_fills"][0].buy_round for r in ordinary if r["side"] == "BUY"] == [1, 2, 1]
+    assert window.completed_cycles == financials
+    if lot_enabled:
+        targets = [r for r in records if r["side"] == "LIMIT_SELL"]
+        assert len(targets) == 1 and targets[0]["evaluation_index"] == 6
+        assert targets[0]["quantity"] == 1 and not targets[0].get("ordinary_execution_fills")
+        assert any(r["evaluation_index"] == 6 and r["side"] == "SELL" for r in ordinary)
+        terminal = _stop_display_window(case, price_candles([100, 90]), (("BUY", 0),), ON, forced=True)
+        residual = next(r for r in terminal._chart_marker_records() if r["side"] == "SELL")
+        assert residual["virtual_residual"] and not residual.get("ordinary_execution_fills")
+        return
+    original = [{k: v for k, v in r.items() if k != "ordinary_execution_fills"} for r in records]
+    first = ordinary[0]["ordinary_execution_fills"][0]
+    sell = next(r for r in ordinary if r["side"] == "SELL")["ordinary_execution_fills"][0]
+    _, _, indexes = window._validation_range_execution_projection()
+    invalid = [replace(first, evaluation_index=indexes.index(first.evaluation_index), quantity=0),
+               replace(first, evaluation_index=indexes.index(first.evaluation_index), evaluation_time="wrong"),
+               *(replace(sell, evaluation_index=indexes.index(sell.evaluation_index), reason=reason)
+                 for reason in ("LOT_LIMIT_TARGET", "STOP_LOSS", "RANGE_END_LIQUIDATION"))]
+    with patch.object(window_module, "simulate_validation_execution",
+                      return_value=SimpleNamespace(fills=invalid)):
+        unfilled = window._chart_marker_records()
+    assert unfilled == original  # Same signals/tooltips; no false execution proof.
+
+
+@pytest.mark.parametrize("side", ["BUY", "SELL"])
+@pytest.mark.parametrize("executed", [False, True])
+@pytest.mark.parametrize("clip", ["none", "top", "bottom"])
+def test_v5_executed_arrow_render_stack_hit_and_clipping(case, side, executed, clip):
+    from PyQt5.QtGui import QPainter, QPixmap
+    from tests.test_v5_lot_limit_execution import candles as price_candles
+    rows = price_candles([100] * 8)
+    window = _stop_display_window(case, rows, (("BUY", 2), ("SELL", 6)), {})
+    record = deepcopy(next(r for r in window._chart_marker_records() if r["side"] == side))
+    if not executed:
+        record.pop("ordinary_execution_fills")
+    index = record["evaluation_index"]
+    markers = [record]
+    if side == "SELL":
+        markers.append(dict(evaluation_index=index, side="LIMIT_SELL", tooltip="target"))
+    canvas = window.canvas
+    canvas.resize(800, 400)
+    canvas.set_marker_records(markers)
+    scale = canvas.price_scale()
+    plot = canvas._price_plot_rect(scale)
+    anchor = {"none": plot.center().y(), "top": plot.top() + 10,
+              "bottom": plot.bottom() - 10}[clip]
+    original_y = canvas._marker_y
+    def fixed_y(i, kind, supplied_scale=None):
+        return anchor + (30 if kind == "LIMIT_SELL" else 0)
+    polygons, clips = [], []
+    class RecordingPainter(QPainter):
+        def setClipRect(self, rect, *args):
+            clips.append(QRectF(rect))
+            return super().setClipRect(rect, *args)
+        def drawPolygon(self, polygon):
+            polygons.append((self.brush().color().name(), [(p.x(), p.y()) for p in polygon]))
+            return super().drawPolygon(polygon)
+    pixmap = QPixmap(canvas.size())
+    pixmap.fill(window_module.Qt.transparent)
+    painter = RecordingPainter(pixmap)
+    with patch.object(canvas, "_marker_y", side_effect=fixed_y), \
+            patch.object(window_module, "simulate_validation_execution", side_effect=AssertionError("paint/hit simulation")):
+        try:
+            canvas._paint_static_chart(painter, scale)
+        finally:
+            painter.end()
+        color = (window_module._BUY if side == "BUY" else window_module._SELL).name()
+        arrows = [points for fill, points in polygons if fill == color]
+        assert len(arrows) == (2 if executed else 1)
+        x = canvas._x_for_index(index)
+        assert all(points[0][0] == x for points in arrows)
+        assert arrows[0][0][1] == anchor + (-8 if side == "BUY" else 8)
+        if executed:
+            shift = 13 if side == "BUY" else -13
+            assert arrows[1] == [(px, py + shift) for px, py in arrows[0]]
+            assert abs(arrows[1][0][1] - arrows[0][1][1]) == 3
+        white = [points for fill, points in polygons if fill == "#ffffff"]
+        assert len(white) == (1 if side == "SELL" else 0)
+        if side == "SELL":
+            assert min(py for _, py in white[0]) - max(py for _, py in arrows[0]) == 20
+            gap_y = anchor + 18
+            if plot.contains(window_module.QPointF(x, gap_y)):
+                assert canvas._marker_at(x, gap_y) is None
+        sample_ys = [anchor, *(py for points in arrows for _, py in points)]
+        if executed:
+            sample_ys.append(anchor + (3.5 if side == "BUY" else -3.5))
+        for y in sample_ys:
+            hit = canvas._marker_at(x, y)
+            if plot.contains(window_module.QPointF(x, y)):
+                assert hit is not None and canvas._marker_key(hit) == (index, side)
+                assert hit["tooltip"] == record["tooltip"]
+            else:
+                assert hit is None
+        assert plot in clips
+        if clip != "none":
+            image = pixmap.toImage()
+            for y in (int(plot.top()) - 1, int(plot.bottom()) + 1):
+                assert image.pixelColor(round(x), y).name() != color
+    if side == "SELL":
+        assert original_y(index, "SELL", scale) == original_y(index, "LIMIT_SELL", scale) - 30
+    assert canvas.marker_records() == markers
+
