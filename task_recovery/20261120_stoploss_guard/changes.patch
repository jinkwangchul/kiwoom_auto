+    def test_stop_loss_approved_commit_validates_actual_candidate_and_preserves_scope(self) -> None:
+        import rule_apply_commit_service
+        import rule_approval_session_file_service
+
+        source_before = self.source_rules_path.read_bytes()
+        writer = rule_apply_commit_service.commit_approved_rule_patch_to_rules
+        schema_error = "sell stop loss enabled must be a boolean"
+        live_hold = "SELL_STOP_LOSS_LIVE_HOLD"
+        cases = (
+            ("on", {"stop_loss": {"enabled": True, "loss_percent": "2.5"}}, [live_hold]),
+            ("off", {"stop_loss": {"enabled": False, "loss_percent": "2.5"}}, []),
+            ("legacy_missing", {}, []),
+            ("null", {"stop_loss": None}, [schema_error]),
+            ("missing_enabled", {"stop_loss": {}}, [schema_error]),
+            ("null_enabled", {"stop_loss": {"enabled": None}}, [schema_error]),
+            ("integer_enabled", {"stop_loss": {"enabled": 1}}, [schema_error]),
+            ("string_enabled", {"stop_loss": {"enabled": "true"}}, [schema_error]),
+            ("on_invalid_percent", {"stop_loss": {"enabled": True, "loss_percent": "-2.5"}},
+             [live_hold, "sell stop loss percent must be a positive finite unsigned decimal"]),
+        )
+        for name, candidate_sell_ui, reasons in cases:
+            with self.subTest(case=name), tempfile.TemporaryDirectory() as temp:
+                rules_path = Path(temp) / "rules.json"
+                rules_path.write_bytes(source_before)
+                dialog = self._dialog(rules_path, instance_id="instance-id")
+                try:
+                    base = deepcopy(dialog.rules_data)
+                    base["bar"]["bar_minutes"] = 1
+                    base["indicator_follow_ui_state"]["state"] = dialog.collect_indicator_follow_ui_state()
+                    base["indicator_follow_ui_state"]["state"]["basic"]["basic_signal_interval_combo"] = "1"
+                    candidate_state = base["indicator_follow_ui_state"]["state"]
+                    candidate_state["sell_ui"].pop("stop_loss", None)
+                    candidate_state["sell_ui"].update(deepcopy(candidate_sell_ui))
+                    if not reasons:
+                        candidate_state["buy_ui"]["signal_filter"].pop("buy_bollinger_sign_combo", None)
+                    rules_path.write_text(json.dumps(base, ensure_ascii=False), encoding="utf-8")
+                    before = rules_path.read_bytes()
+                    dialog.basic_signal_interval_combo.setCurrentText("5")
+                    dialog.sell_stop_loss_check.setChecked(not reasons)
+                    dialog.sell_stop_loss_percent_line.setText("3.5")
+                    ui_state = dialog.collect_indicator_follow_ui_state()
+                    self.assertNotEqual(base["indicator_follow_ui_state"]["state"], ui_state)
+                    mapper = dialog._load_indicator_follow_rule_mapper()
+                    preview = mapper.build_engine_rules_preview_from_ui_state(ui_state, base)
+                    session = mapper.build_rule_approval_session(preview, {"bar.bar_minutes": "APPROVED"})
+                    fingerprint = mapper.build_rule_approval_session_fingerprint(base, preview)
+                    session["fingerprint"] = fingerprint["fingerprint"]
+                    session["fingerprint_detail"] = fingerprint
+                    dialog._approval_session_path = Path(temp) / "approval_session.json"
+                    saved = rule_approval_session_file_service.save_rule_approval_session(
+                        session, dialog._approval_session_path,
+                    )
+                    self.assertTrue(saved["saved"], saved)
+                    expected = deepcopy(base)
+                    expected["bar"]["bar_minutes"] = 5
+                    final_writes = []
+
+                    def write_at_boundary(path, apply_preview, gate, context):
+                        if Path(path).resolve() == rules_path.resolve():
+                            final_writes.append(deepcopy(apply_preview))
+                            if reasons:
+                                return {"ok": False, "committed": False}
+                        return writer(path, apply_preview, gate, context)
+
+                    instance = SimpleNamespace(instance_id="instance-id", definition_id="indicator_follow",
+                                               rules_path=rules_path)
+                    with (
+                        patch("gui_indicator_follow_routine_settings_dialog.routine_instance_by_id",
+                              return_value=instance),
+                        patch.object(rule_apply_commit_service, "commit_approved_rule_patch_to_rules",
+                                     side_effect=write_at_boundary),
+                        patch("gui_indicator_follow_routine_settings_dialog.QMessageBox.question",
+                              return_value=QMessageBox.Yes),
+                        patch("gui_indicator_follow_routine_settings_dialog.QMessageBox.information") as information,
+                        patch("gui_indicator_follow_routine_settings_dialog.QMessageBox.warning"),
+                    ):
+                        if reasons:
+                            result = dialog._handle_approved_rule_commit_clicked()
+                            information.assert_not_called()
+                        else:
+                            result = dialog.commit_saved_approved_rule_changes(manual_rule_commit_confirmed=True)
+                    self.assertTrue(result["dry_run_result"]["ok"], result)
+                    self.assertTrue(result["commit_gate"]["commit_allowed"], result)
+                    if reasons:
+                        self.assertEqual(0, len(final_writes))
+                        self.assertFalse(result["ok"])
+                        self.assertFalse(result["committed"])
+                        self.assertEqual(reasons, result["internal_blocked_reasons"])
+                        self.assertEqual(before, rules_path.read_bytes())
+                    else:
+                        self.assertTrue(result["ok"], result)
+                        self.assertTrue(result["committed"])
+                        self.assertEqual(1, len(final_writes))
+                        self.assertEqual(expected, final_writes[0]["applied_rules_preview"])
+                        self.assertEqual(expected, json.loads(rules_path.read_text(encoding="utf-8")))
+                finally:
+                    dialog.close()
+        self.assertEqual(source_before, self.source_rules_path.read_bytes())
