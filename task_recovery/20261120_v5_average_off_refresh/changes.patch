+@pytest.mark.parametrize("confirmation", ["focus_out", "enter"])
+@pytest.mark.parametrize("control_name,save_key,edited,saved", [
+    ("first_buy_quantity_line", "first_buy_quantity", "7", "7"),
+    ("repeat_mode_combo", "repeat_mode", "예산기준", "예산기준"),
+    ("round_operator_combo", "round_operator", "x", "x"),
+    ("round_budget_line", "round_value", "3", "3.0"),
+    ("budget_ratio_line", "budget_ratio", "4", "4.0"),
+    ("active_direction_combo", "active_direction", "하향", "하향"),
+    ("active_ratio_line", "active_ratio", "0.7", "0.7"),
+    ("active_compare_combo", "active_compare", "이하", "이하"),
+])
+def test_inactive_averaging_confirmation_preserves_chart_and_saves_draft(
+        inactive_averaging_window, confirmation, control_name, save_key, edited, saved):
+    from PyQt5.QtGui import QFocusEvent, QKeyEvent
+
+    window, store, snapshot, work, flow = inactive_averaging_window
+    before = snapshot()
+    canvas = window.canvas
+    control = getattr(window, "validation_" + control_name)
+    if hasattr(control, "isReadOnly"):
+        assert not control.isReadOnly()
+        original = control.text()
+        edit = control.setText
+    else:
+        assert control.isEnabled()
+        original = control.currentText()
+        edit = control.setCurrentText
+    # Repeated edits and equal-state confirmations must not leave a suppression latch.
+    for value, expected in ((edited, saved), (original, store.load()[save_key]),
+                            (edited, saved)):
+        edit(value)
+        assert store.load()[save_key] == expected
+        for _ in range(2):
+            event = (QFocusEvent(QEvent.FocusOut) if confirmation == "focus_out" else
+                     QKeyEvent(QEvent.KeyPress, Qt.Key_Return, Qt.NoModifier))
+            QApplication.sendEvent(control, event)
+            assert window._signal_ui_confirmation_queued
+            QApplication.processEvents()
+            QTest.qWait(220)
+            assert window.canvas is canvas
+            assert snapshot() == before
+            assert window._validated_ui_fingerprint == "completed-validation"
+            assert not window._range_filter_edit_replay_timer.isActive()
+            assert work == []
+            assert not flow._prepare_active and not flow._prepare_pending
+
+
+@pytest.mark.parametrize("independent", ["cost", "buy", "sell"])
+def test_inactive_averaging_draft_does_not_hide_independent_change(
+        inactive_averaging_window, independent):
+    window, store, snapshot, work, _flow_instance = inactive_averaging_window
+    before = snapshot()
+    window.validation_first_buy_quantity_line.setText("7")
+    assert window._flush_pending_signal_validation_ui_confirmation()
+    assert snapshot() == before
+    window.validation_first_buy_quantity_line.setText("11")
+    if independent == "cost":
+        window.validation_trading_cost_percent_line.setText("0.35")
+    elif independent == "buy":
+        window.buy_signal_expr_line.setText("A or D")
+    else:
+        window.sell_signal_expr_line.setText("A or B")
+    assert window._flush_pending_signal_validation_ui_confirmation()
+    QTest.qWait(220)
+    assert snapshot() != before
+    assert window._validated_ui_fingerprint is None
+    assert ("range", 0, 4) in work
+    assert store.load()["first_buy_quantity"] == "11"
+    assert not any(isinstance(item, tuple) and item[0] == "quote" for item in work)
+
