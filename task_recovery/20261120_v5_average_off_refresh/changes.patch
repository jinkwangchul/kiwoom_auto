+@pytest.mark.parametrize("edit", [False, True], ids=["ordinary_equal", "off_draft"])
+def test_inactive_averaging_confirmation_allows_existing_pending_completion(
+        inactive_averaging_window, monkeypatch, edit):
+    window, _store, _snapshot_state, work, flow = inactive_averaging_window
+    key = id(window)
+    request = {"generation": 17, "token": object()}
+    flow._supplied_normal_base_waiting = {key: request}
+    completed = []
+    # Hold the asynchronous publication boundary; the real resume owns pending state.
+    monkeypatch.setattr(flow, "_on_signal_scan_completed", completed.append)
+    if edit:
+        window.validation_first_buy_quantity_line.setText("7")
+    assert window._flush_pending_signal_validation_ui_confirmation()
+    assert key not in flow._supplied_normal_base_waiting
+    assert len(completed) == 1
+    assert completed[0]["generation"] == 17
+    assert completed[0]["retry_after_invalid"] is True
+    assert completed[0]["prepare_token"] is flow._prepare_active[key]
+    assert window._flush_pending_signal_validation_ui_confirmation()
+    QTest.qWait(220)
+    assert len(completed) == 1
+    assert work == []
+
+
