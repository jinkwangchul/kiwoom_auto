+def test_inactive_averaging_saved_quantity_applies_on_enable_and_off_transition(
+        inactive_averaging_window):
+    from copy import deepcopy
+
+    window, store, _snapshot_state, work, _flow_instance = inactive_averaging_window
+    entries = deepcopy(window._range_replay_entries)
+    window.validation_first_buy_quantity_line.setText("7")
+    window.validation_repeat_mode_combo.setCurrentText("예산기준")
+    window.validation_round_operator_combo.setCurrentText("x")
+    window.validation_round_budget_line.setText("3")
+    window.validation_budget_ratio_line.setText("4")
+    window.validation_active_direction_combo.setCurrentText("하향")
+    window.validation_active_ratio_line.setText("0.7")
+    window.validation_active_compare_combo.setCurrentText("이하")
+    assert window._flush_pending_signal_validation_ui_confirmation()
+    assert store.load()["first_buy_quantity"] == "7"
+    window.validation_averaging_enabled_check.setChecked(True)
+    assert window._flush_pending_signal_validation_ui_confirmation()
+    QTest.qWait(220)
+    assert ("range", 0, 4) in work
+    assert window.validation_first_buy_quantity_line.isReadOnly()
+    policy = window._marking_current_settings().to_dict()["validation_execution"]
+    assert policy["enabled"] is True and policy["first_buy_quantity"] == 7
+    assert policy["repeat_mode"] == "BUDGET"
+    assert policy["round_operator"] == "MULTIPLY" and policy["round_budget_value"] == 3
+    assert policy["budget_ratio"] == 4 and policy["active_direction"] == "DOWN"
+    assert policy["active_ratio"] == 0.7 and policy["active_compare"] == "<="
+    window._range_replay_settings_snapshot = ValidationSettingsSnapshot({
+        "validation_execution": policy,
+    })
+    # Supply the offline range result after the legitimate ON reevaluation request.
+    window._range_replay_entries_available = True
+    window._range_replay_entries = entries
+    window._populate_completed_cycles()
+    assert len(window.completed_cycles) == 1
+    assert window.completed_cycles[0].buy_quantity == 7
+    work.clear()
+    window.validation_averaging_enabled_check.setChecked(False)
+    assert window._flush_pending_signal_validation_ui_confirmation()
+    QTest.qWait(220)
+    assert ("range", 0, 4) in work
+    assert not window.validation_first_buy_quantity_line.isReadOnly()
+    assert store.load()["first_buy_quantity"] == "7"
+
