+    marker = json.loads(Path(str(path) + ".market-source.json").read_text(encoding="utf-8"))
+    assert document["candles"] == stored and len(document["candles"]) == 5900
+    assert marker["candle_content_sha256"] == f._marking_revision_candle_identity(stored)
+    assert marker["direct_selected_query"] == kwargs["direct_selected_query"]
+    assert f._direct_selected_query_valid(marker["direct_selected_query"], c.stock,
+                                         "M3", 3, "005930_AL", stored)
+    assert marker["direct_selected_query"]["request_id"] == pool["request_id"]
+    terminal = marker["direct_selected_query"].get("terminal_history_receipt")
