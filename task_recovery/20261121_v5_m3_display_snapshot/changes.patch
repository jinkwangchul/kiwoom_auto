+@pytest.mark.parametrize("forming,delay_seconds", [(False, 1), (True, 185)],
+                         ids=["5901-completed", "5900-plus-forming-delayed"])
+def test_integrated_m3_received_display_freeze_range_alignment(
+        supplied_projection, monkeypatch, tmp_path, forming, delay_seconds):
+    from pathlib import Path
+    from indicator_follow_signal_validation_historical_cache import (
+        IndicatorFollowSignalValidationHistoricalCache,
+    )
+    h = supplied_projection
+    c, f = h.c, h.c.flow
+    as_of = datetime.fromisoformat("2026-10-30T11:44:00+09:00")
+    at = as_of.replace(minute=42 if forming else 39)
+    stamps = []
+    while len(stamps) < 5901:
+        if at.weekday() < 5 and (9, 0) <= (at.hour, at.minute) <= (15, 15):
+            stamps.append(at.strftime("%Y%m%d%H%M%S"))
+        at -= timedelta(minutes=3)
+    rows = [dict(time=t, open=100., high=103., low=99., close=101., volume=10.)
+            for t in reversed(stamps)]
+    rows[-1].update(open=201., high=205., low=198., close=203., volume=37.)
+    seed = v5.IndicatorFollowSignalValidationSeed(v5.ValidationSettingsSnapshot({
+        "bar": {"bar_minutes": 3}, "validation_timeframe": {"key": "M3"},
+    }), {})
+    cache = IndicatorFollowSignalValidationHistoricalCache(tmp_path / "history")
+    monkeypatch.setattr(f, "_historical_cache", cache)
+    # Exercise the real cache content/sidecar writer, under the isolated root.
+    persisted = []
+    def persist(*args, **kwargs):
+        persisted.append((deepcopy(args), deepcopy(kwargs)))
+        return type(f)._persist_history(f, *args, **kwargs)
+    monkeypatch.setattr(f, "_persist_history", persist)
+    w, received = h.start(candles=rows, as_of=as_of, seed=seed,
+                          delay_seconds=delay_seconds)
+    expected = deepcopy(rows)  # Never derive the display expectation from the pool.
+    assert received == expected and w._calculation_candles == expected
+    assert len(w._candles) == 5000
+    f._on_signal_scan_completed(h.run())
+    assert w._normal_base_ready
+    session, pool = f._validation_sessions[id(w)], f._historical_pools[id(w)]
+    frozen = deepcopy(f._v5_tr_snapshots[pool["_v5_tr_snapshot"]])
+    c.clock[0] += timedelta(minutes=10)
+    ranges = []
+    monkeypatch.setattr(f, "_emit_range_replay_completed", ranges.append)
+    w._set_validation_range(4995, 4999)
+    with _frozen_source_plan() as root, patch("routine_signal_probe.PROJECT_ROOT", root):
+        f._run_cached_range_replay(w, 4995, 4999)
+        assert len(h.jobs) == 1
+        h.jobs.pop()()
+    assert len(ranges) == 1
+    assert not ranges[0].get("error"), ranges[0].get("error")
+    assert ranges[0]["snapshot"].to_candles() == expected
+    f._on_range_replay_completed(ranges.pop())
+    assert w._range_replay_entries_available
+    assert f._direct_tr_snapshot(session, pool)["candles"] == expected
+    assert pool["candles"] == (expected[:-1] if forming else expected)
+    assert w._calculation_candles == expected
+    assert f._v5_tr_snapshots[pool["_v5_tr_snapshot"]] == frozen
+    assert len(c.calls) == 1 and not h.jobs
+    assert c.calls[0]["options"]["count"] == 5900
+    assert len(persisted) == 1
