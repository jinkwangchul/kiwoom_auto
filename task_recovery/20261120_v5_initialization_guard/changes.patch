+@pytest.mark.parametrize("canvas_lifecycle", ["never_created", "cleared"])
+def test_v5_retained_ohlc4_restore_finishes_without_canvas(case, canvas_lifecycle):
+    from indicator_follow_signal_validation_preferences import (
+        IndicatorFollowSignalValidationPreferenceStore,
+    )
+
+    window = window_for(case)
+    assert not hasattr(window, "canvas")
+    if canvas_lifecycle == "cleared":
+        install(window, candles(5))
+        window._clear_validation_result("offline regression")
+        assert window.canvas is None
+    values = {}
+    store = IndicatorFollowSignalValidationPreferenceStore(settings=SimpleNamespace(
+        value=values.get, setValue=values.__setitem__,
+    ))
+    store.save_retained_settings({
+        "enabled": True,
+        "ui_state": window.collect_indicator_follow_ui_state(),
+        "display": {"virtual_price_basis": "OHLC4", "range_liquidation": True},
+    })
+    window.result_summary_label.setText("stale results")
+
+    window.set_validation_preferences_store(store)
+
+    assert window.validation_virtual_price_badge.text() == "평균"
+    assert window.validation_virtual_price_badge.isChecked()
+    assert window.validation_range_liquidation_check.isChecked()
+    assert window.validation_settings_keep_check.isChecked()
+    assert window.result_summary_label.text() != "stale results"
+    assert window.completed_cycles == ()
+    if canvas_lifecycle == "never_created":
+        assert not hasattr(window, "canvas")
+    else:
+        assert window.canvas is None
+
