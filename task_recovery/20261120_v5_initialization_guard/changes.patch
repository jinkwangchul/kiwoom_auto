+def test_v5_canvas_republishes_execution_markers_on_price_and_liquidation_changes(case):
+    from tests.test_v5_lot_limit_execution import candles as price_candles
+
+    rows = price_candles([100, 110, 120, 130, 140])
+    rows[0].update(open=80, high=120, low=60)
+    window = _stop_display_window(
+        case, rows, (("BUY", 0), ("SELL", 2), ("BUY", 3)), {},
+    )
+    canvas = window.canvas
+    with patch.object(window_module.QTimer, "singleShot"):
+        for basis, buy_price in (("OHLC4", 90), ("CLOSE", 100)):
+            window._select_virtual_fill_price_basis(basis)
+            for liquidate in (True, False):
+                window.validation_range_liquidation_check.setChecked(liquidate)
+                records = canvas.marker_records()
+                ordinary = [r for r in records if r.get("ordinary_execution_fills")]
+                assert [(r["evaluation_index"], r["side"]) for r in ordinary] == [
+                    (0, "BUY"), (2, "SELL"), (3, "BUY"),
+                ]
+                assert [(f.price, f.quantity) for r in ordinary
+                        for f in r["ordinary_execution_fills"]] == [
+                    (buy_price, 1), (120, 1), (130, 1),
+                ]
+                assert canvas._liquidation_marker_records() == (
+                    [{"evaluation_index": 4, "side": "SELL", "virtual_liquidation": True}]
+                    if liquidate else []
+                )
+                assert len(window.completed_cycles) == (2 if liquidate else 1)
+
+
