@@ -4,6 +4,117 @@ from copy import deepcopy
 import math
 
 from engines.condition_engine import parse_condition_expression
+from indicator_follow_signal_validation_execution import (
+    ValidationVirtualPositionTracker, validation_virtual_fill_price,
+)
+
+
+BUY_CONDITION_PROTOCOL = "V5_BUY_CONDITION_V1"
+
+
+def v5_stop_execution_metadata(rules, *, price_basis="CLOSE", regular_only=False):
+    state = rules.get("indicator_follow_ui_state", {}).get("state", {})
+    stop = state.get("sell_ui", {}).get("stop_loss", rules.get("sell", {}).get("stop_loss", {}))
+    if not isinstance(stop, dict) or stop.get("enabled") is not True:
+        return {}
+    return {"_v5_stop_config": deepcopy(stop), "_v5_stop_protocol": BUY_CONDITION_PROTOCOL,
+            "_v5_stop_price_basis": price_basis, "_v5_stop_regular_only": bool(regular_only)}
+
+
+class V5ValidationPositionTracker(ValidationVirtualPositionTracker):
+    """V5 virtual stop precheck and same-cycle latch, independent of BUY sizing."""
+
+    def __init__(self, policy=None, *, stop_config=None, stop_price_basis="CLOSE",
+                 eligible_indices=None, buy_condition_events=(), buy_condition_candles=None):
+        super().__init__(policy)
+        self.stop_config = deepcopy(stop_config or {})
+        self.stop_price_basis = stop_price_basis
+        self.stop_enabled = self.stop_config.get("enabled") is True
+        source = policy if isinstance(policy, dict) else {}
+        self._stop_regular_only = source.get("_v5_stop_regular_only") is True
+        self._stop_timeframe = str(source.get("_v5_execution_timeframe_key") or "")
+        self.eligible_indices = None if eligible_indices is None else frozenset(eligible_indices)
+        self.buy_condition_events = deepcopy(list(buy_condition_events or ()))
+        self._condition_candles = deepcopy(buy_condition_candles)
+        self._stop_prechecked_through = -1
+        self._stop_indexes = set()
+        self._stop_index = -1
+        self._condition_through = -1
+        self._restart_false_index = None
+        self._restart_state = None
+        self._condition_event_count = 0
+        self._condition_observed_through = -1
+        self._condition_by_time = {}
+
+    def observe_buy_condition(self, event):
+        if self.stop_enabled:
+            self.buy_condition_events.append(deepcopy(event))
+
+    def _stop_eligible(self, index, candle):
+        time = str(candle.get("time") or "")
+        if self._stop_timeframe == "M5" and time.endswith("153500"):
+            return False
+        if (self._stop_regular_only and self._stop_timeframe.startswith("M")
+                and self._stop_timeframe[1:].isdigit()
+                and (len(time) != 14 or not time.isdigit() or not "0900" <= time[8:12] < "1520")):
+            return False
+        return ((self.eligible_indices is None or index in self.eligible_indices)
+                and validation_virtual_fill_price(candle, price_basis=self.stop_price_basis) is not None)
+
+    def _touch_limits(self, index, candle):
+        if self.stop_enabled and index > self._stop_prechecked_through:
+            self._stop_prechecked_through = index
+            if self._stop_eligible(index, candle) and self.holding_quantity > 0:
+                from decimal import Decimal, InvalidOperation
+                from fractions import Fraction
+                price = validation_virtual_fill_price(candle, price_basis=self.stop_price_basis)
+                magnitude = self.stop_config.get("loss_percent")
+                try:
+                    loss = Decimal(str(magnitude))
+                    average = Decimal(str(self.average_buy_price))
+                    triggered = (not isinstance(magnitude, bool) and loss.is_finite()
+                                 and 0 < loss <= 100 and average.is_finite() and average > 0
+                                 and Fraction(Decimal(str(price))) <= Fraction(average) * (1 - Fraction(loss) / 100))
+                except (InvalidOperation, TypeError, ValueError, OverflowError):
+                    triggered = False
+                if triggered:
+                    self._close_position(index, candle, price, close_reason="STOP_LOSS")
+                    self._stop_indexes.add(index)
+                    self._stop_index = index
+                    self._restart_state = "WAIT_FALSE"
+                    self._restart_false_index = None
+        if index not in self._stop_indexes:
+            super()._touch_limits(index, candle)
+
+    def _apply_index(self, index, candles, entries, *, signals_by_index=None):
+        if not self.stop_enabled:
+            return super()._apply_index(index, candles, entries, signals_by_index=signals_by_index)
+        from routines.지표추종매매.routine_validation_replay import valid_buy_condition_event
+        self._touch_limits(index, candles[index])
+        if index in self._stop_indexes:
+            return
+        for event in self.buy_condition_events[self._condition_event_count:]:
+            if (valid_buy_condition_event(event, self._condition_candles if self._condition_candles is not None else candles)
+                    and event["evaluation_index"] > self._condition_observed_through):
+                self._condition_observed_through = event["evaluation_index"]
+                self._condition_by_time[event["evaluation_time"]] = event
+        self._condition_event_count = len(self.buy_condition_events)
+        event = self._condition_by_time.pop(str(candles[index].get("time") or ""), None)
+        if (event is not None and self._stop_eligible(index, candles[index])
+                and index > max(self._condition_through, self._stop_index)
+                and event.get("status") == "EVALUATED"):
+            self._condition_through = index
+            if self._restart_state == "WAIT_FALSE" and event["buy_result"] is False:
+                self._restart_state = "WAIT_TRUE"
+                self._restart_false_index = index
+            elif (self._restart_state == "WAIT_TRUE" and event["buy_result"] is True
+                  and index > self._restart_false_index):
+                self._restart_state = None
+        signals = (set(signals_by_index.get(index, ())) if signals_by_index is not None
+                   else self._signals_at(index, candles, entries))
+        if self._restart_state is not None:
+            signals.discard("BUY")
