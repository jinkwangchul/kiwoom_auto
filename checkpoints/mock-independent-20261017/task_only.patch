diff --git a/mock_validation_repository.py b/mock_validation_repository.py
index 411bfab..4c06eb4 100644
--- a/mock_validation_repository.py
+++ b/mock_validation_repository.py
@@ -577,0 +628,53 @@ class MockValidationRepository:
+    def purge_stock_lifecycles(
+        self, stock_code: str, *, expected_current_session_id: str
+    ) -> dict[str, Any]:
+        """Purge every Mock lifecycle for one stock, regardless of its state."""
+        code = normalized_stock_code(stock_code)
+        with self._lock:
+            if self.current_session_id(code) != expected_current_session_id:
+                raise MockValidationError("MOCK_PURGE_CURRENT_IDENTITY_STALE")
+            session_ids: set[str] = set()
+            for path in self._target("runtime/sessions").glob("*.json"):
+                document = self.read_session(path.stem)
+                if document["session"]["stock_code"] == code:
+                    session_ids.add(path.stem)
+            for path in self._target("history").glob("*.json"):
+                history = self.read_history(path.stem)
+                if history["session_document"]["session"]["stock_code"] == code:
+                    session_ids.add(path.stem)
+            for path in self._target("events").glob("*.json"):
+                if path.stem in session_ids:
+                    continue
+                event_codes = {
+                    normalized_stock_code(event.get("stock_code"))
+                    for event in self.read_events(path.stem)
+                }
+                if code in event_codes:
+                    if event_codes != {code}:
+                        raise MockValidationError("MOCK_PURGE_EVENT_STOCK_IDENTITY_MISMATCH")
+                    session_ids.add(path.stem)
+            if expected_current_session_id and expected_current_session_id not in session_ids:
+                raise MockValidationError("MOCK_PURGE_CURRENT_SESSION_MISSING")
+            for session_id in session_ids:
+                session_path = self._target(self._session_relative(session_id))
+                history_path = self._target(Path("history") / f"{session_id}.json")
+                if session_path.exists() and self.read_session(session_id)["session"]["stock_code"] != code:
+                    raise MockValidationError("MOCK_PURGE_STOCK_IDENTITY_MISMATCH")
+                if history_path.exists() and self.read_history(session_id)["session_document"]["session"]["stock_code"] != code:
+                    raise MockValidationError("MOCK_PURGE_HISTORY_IDENTITY_MISMATCH")
+                self.read_events(session_id)
+            removed: list[str] = []
+            self._write_current_index(code, None)
+            for session_id in sorted(session_ids):
+                for relative in (
+                    self._session_relative(session_id),
+                    Path("history") / f"{session_id}.json",
+                    Path("events") / f"{session_id}.json",
+                ):
+                    target = self._target(relative)
+                    if target.exists():
+                        target.unlink()
+                        removed.append(str(relative).replace("\\", "/"))
+            self._session_cache.cache_clear()
+            return {"stock_code": code, "session_ids": tuple(sorted(session_ids)), "removed": tuple(removed)}
+
