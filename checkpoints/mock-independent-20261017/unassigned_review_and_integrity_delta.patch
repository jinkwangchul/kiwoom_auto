+def inspect_unassigned_operation_state(
+    project_root: Path, stock_code: str, stock_name: str = "",
+) -> dict[str, Any]:
+    """Read only: identify an unassigned stock with stale operation authority."""
+    repository = StockRepository(project_root)
+    record = repository.find_by_code(stock_code)
+    if record is None or (stock_name and record.name != stock_name):
+        return {"mismatch": False, "reason": "STOCK_IDENTITY_CHANGED"}
+    stock_dir = repository.resolve_stock_dir(stock_code, record.name)
+    config_path, state_path = stock_dir / "config.json", stock_dir / "state.json"
+    try:
+        config_bytes, state_bytes = config_path.read_bytes(), state_path.read_bytes()
+        config = json.loads(config_bytes.decode("utf-8-sig"))
+        state = json.loads(state_bytes.decode("utf-8-sig"))
+    except Exception as exc:
+        return {"mismatch": False, "reason": f"STOCK_DATA_UNAVAILABLE: {exc}"}
+    if not isinstance(config, dict) or not isinstance(state, dict) or not state:
+        return {"mismatch": False, "reason": "STOCK_DATA_INVALID"}
+    if str(config.get("assigned_routine_instance_id") or "").strip():
+        return {"mismatch": False, "reason": "STOCK_ASSIGNED"}
+    mismatch = (
+        str(state.get("status") or "").strip().upper() in (
+            "RUNNING", "STARTED", "AUTO", "TRADING"
+        )
+        or state.get("trade_enabled") is True
+    )
+    return {
+        "mismatch": mismatch,
+        "reason": UNASSIGNED_STATE_MISMATCH if mismatch else "UNCHANGED",
+        "stock_dir": stock_dir,
+        "config_sha256": sha256(config_bytes).hexdigest(),
+        "state_sha256": sha256(state_bytes).hexdigest(),
+        "status": str(state.get("status") or ""),
+        "trade_enabled": state.get("trade_enabled"),
+    }
+
+
+def quarantine_unassigned_operation_state(
+    project_root: Path, stock_code: str, stock_name: str, *, owner: object | None,
+) -> dict[str, Any]:
+    """Enter Review only after identity, source bytes, and session guards hold."""
+    inspected = inspect_unassigned_operation_state(project_root, stock_code, stock_name)
+    if not inspected.get("mismatch"):
+        return {"ok": inspected.get("reason") == "UNCHANGED", "changed": False,
+                "reason": inspected.get("reason")}
+    try:
+        if stock_code in auto_trade_current_session_operation_participant_codes(owner):
+            return {"ok": False, "changed": False, "reason": "CURRENT_SESSION_PARTICIPANT"}
+    except Exception:
+        return {"ok": False, "changed": False, "reason": "PARTICIPANT_EVIDENCE_UNAVAILABLE"}
+    checked = inspect_unassigned_operation_state(project_root, stock_code, stock_name)
+    if not checked.get("mismatch") or any(
+        checked.get(key) != inspected.get(key)
+        for key in ("stock_dir", "config_sha256", "state_sha256")
+    ):
+        return {"ok": False, "changed": False, "reason": "STOCK_DATA_CHANGED"}
+    try:
+        if stock_code in auto_trade_current_session_operation_participant_codes(owner):
+            return {"ok": False, "changed": False, "reason": "CURRENT_SESSION_PARTICIPANT"}
+    except Exception:
+        return {"ok": False, "changed": False, "reason": "PARTICIPANT_EVIDENCE_UNAVAILABLE"}
+    stock_dir = checked["stock_dir"]
+    timestamp = _now_text()
+    evidence = (
+        f"{UNASSIGNED_STATE_MISMATCH} stock_code={stock_code} "
+        f"config_sha256={checked['config_sha256']} state_sha256={checked['state_sha256']} "
+        f"status={checked['status']} trade_enabled={checked['trade_enabled']} "
+        "current_session_participant=false"
+    )
+    mutation = mutate_runtime_stock_state(
+        stock_dir, "REVIEW_REQUIRED",
+        {"trade_enabled": False, "review_required": True,
+         "review_status": "PENDING", "review_location": "종목관리",
+         "review_reason": operator_review_reason("운영 데이터 불일치"),
+         "review_detail": evidence, "review_checked_at": timestamp,
+         "review_entered_at": timestamp},
+        updated_at=timestamp, verify_readback=True,
+    )
+    return {"ok": mutation.ok, "changed": mutation.ok,
+            "reason": "REVIEW_REQUIRED" if mutation.ok else mutation.reason}
 
 
